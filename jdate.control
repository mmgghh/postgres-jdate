comment = 'Jalali (Persian) calendar date type'
default_version = '1.0'
module_pathname = '$libdir/jdate'
# Not relocatable: the script registers extract(text, jdate) in pg_catalog,
# because EXTRACT(... FROM x) always resolves to pg_catalog.extract. That
# function cannot follow the rest of the extension into another schema, so
# ALTER EXTENSION jdate SET SCHEMA cannot work. Choose the schema at install
# time instead: CREATE EXTENSION jdate SCHEMA s.
relocatable = false
