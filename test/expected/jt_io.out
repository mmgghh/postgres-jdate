---------------------+------------
 1403-05-02 12:34:56 | infinity
(1 row)

SET DateStyle = 'ISO, YMD';
-- ---------------------------------------------------------------------
-- arrays
-- ---------------------------------------------------------------------
SELECT ARRAY['1403-01-01 10:00', '1403-12-29 23:59:59.5']::jtimestamp[] AS arr;
                       arr                       
-------------------------------------------------
