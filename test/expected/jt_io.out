\set VERBOSITY default
-- ---------------------------------------------------------------------
-- DateStyle does not change the text, in or out
-- ---------------------------------------------------------------------
DO $do$
DECLARE s text;
BEGIN
  FOREACH s IN ARRAY ARRAY['ISO, YMD', 'ISO, DMY', 'ISO, MDY', 'SQL, DMY', 'SQL, MDY',
                           'German', 'Postgres, DMY', 'Postgres, MDY']
  LOOP
    PERFORM set_config('DateStyle', s, false);
    RAISE INFO '%: % and %', s, '1403-05-02 12:34:56.5'::jtimestamp,
               '1403-02-05 01:02:03'::jtimestamp;
  END LOOP;
  PERFORM set_config('DateStyle', 'ISO, YMD', false);
END
$do$;
INFO:  ISO, YMD: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  ISO, DMY: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  ISO, MDY: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  SQL, DMY: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  SQL, MDY: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  German: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  Postgres, DMY: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
INFO:  Postgres, MDY: 1403-05-02 12:34:56.5 and 1403-02-05 01:02:03
SET DateStyle = 'German';
SELECT '1403-05-02 12:34:56'::jtimestamp, '1403-02-05 01:02:03'::jtimestamp;
     jtimestamp      |     jtimestamp      
---------------------+---------------------
 1403-05-02 12:34:56 | 1403-02-05 01:02:03
(1 row)

SET DateStyle = 'Postgres, MDY';
SELECT '1403-05-02 12:34:56'::jtimestamp, '1403-02-05 01:02:03'::jtimestamp;
     jtimestamp      |     jtimestamp      
---------------------+---------------------
 1403-05-02 12:34:56 | 1403-02-05 01:02:03
(1 row)

SET DateStyle = 'SQL, DMY';
SELECT '1403-05-02 12:34:56'::jtimestamp, 'infinity'::jtimestamp;
