SET enable_bitmapscan = off;
SELECT count(*) AS idx_rows, sum(id) AS idx_sum
FROM jt_ops_big_tz WHERE v BETWEEN (SELECT v FROM jt_ops_big_tz WHERE id = 100) AND (SELECT v FROM jt_ops_big_tz WHERE id = 5000);
 idx_rows | idx_sum  
----------+----------
     4901 | 12497550
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SET enable_indexscan = off;
SET enable_bitmapscan = off;
SELECT count(*) AS seq_rows, sum(id) AS seq_sum
FROM jt_ops_big_tz WHERE v BETWEEN (SELECT v FROM jt_ops_big_tz WHERE id = 100) AND (SELECT v FROM jt_ops_big_tz WHERE id = 5000);
 seq_rows | seq_sum  
----------+----------
     4901 | 12497550
(1 row)

RESET enable_indexscan;
RESET enable_bitmapscan;
-- ---------------------------------------------------------------------
-- hash support: equal values hash equally and as core's type does; the
-- seeded hash agrees with the plain one in the low 32 bits at seed 0
-- ---------------------------------------------------------------------
SELECT count(*) FILTER (WHERE a.rank = b.rank AND jtimestamptz_hash(a.v) <> jtimestamptz_hash(b.v)) AS equal_values_unequal_hash,
       count(*) FILTER (WHERE a.rank = b.rank AND jtimestamptz_hash_extended(a.v, 7) <> jtimestamptz_hash_extended(b.v, 7)) AS equal_values_unequal_ext_hash,
       count(*) FILTER (WHERE a.rank <> b.rank AND jtimestamptz_hash(a.v) = jtimestamptz_hash(b.v)) AS distinct_values_same_hash
FROM jt_ops_tz a CROSS JOIN jt_ops_tz b;
 equal_values_unequal_hash | equal_values_unequal_ext_hash | distinct_values_same_hash 
---------------------------+-------------------------------+---------------------------
                         0 |                             0 |                         0
(1 row)

-- core's hash of a timestamptz, as the default hash opclass of timestamptz on THIS
-- server computes it, so the check is the same on PostgreSQL 16, 17 and 18. The opclass
-- names the function: PostgreSQL 18 has timestamptz_hash and timestamptz_hash_extended,
-- before 18 the opclass uses timestamp_hash and timestamp_hash_extended on the same
-- eight bytes (they take a timestamp, so the instant goes in as its UTC wall clock,
-- which is the same microsecond count). seed NULL is the plain hash (support
-- function 1), otherwise the seeded one (support function 2).
CREATE FUNCTION pg_temp.core_tz_hash(v timestamptz, seed bigint DEFAULT NULL) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
    fn regproc;
    argtype oid;
    r bigint;
BEGIN
    SELECT p.amproc, pr.proargtypes[0] INTO STRICT fn, argtype
    FROM pg_opclass c
         JOIN pg_am a ON a.oid = c.opcmethod
         JOIN pg_amproc p ON p.amprocfamily = c.opcfamily
                         AND p.amproclefttype = c.opcintype AND p.amprocrighttype = c.opcintype
         JOIN pg_proc pr ON pr.oid = p.amproc
    WHERE a.amname = 'hash' AND c.opcintype = 'timestamptz'::regtype AND c.opcdefault
      AND p.amprocnum = CASE WHEN seed IS NULL THEN 1 ELSE 2 END;
    EXECUTE format('SELECT %s(%s%s)', fn,
                   CASE WHEN argtype = 'timestamp'::regtype THEN '$1 AT TIME ZONE ''UTC'''
                        WHEN argtype = 'timestamptz'::regtype THEN '$1' END,
                   CASE WHEN seed IS NULL THEN '' ELSE ', $2' END)
        INTO r USING v, seed;
    RETURN r;
END
$$;
-- the functions it finds: the timestamptz ones on 18 and later, the timestamp ones before
SELECT proc1.amproc::text = CASE WHEN current_setting('server_version_num')::int >= 180000
                                 THEN 'timestamptz_hash' ELSE 'timestamp_hash' END AS hash_function_as_expected,
       proc2.amproc::text = CASE WHEN current_setting('server_version_num')::int >= 180000
                                 THEN 'timestamptz_hash_extended' ELSE 'timestamp_hash_extended' END AS extended_function_as_expected
FROM pg_opclass c
     JOIN pg_am a ON a.oid = c.opcmethod
     JOIN pg_amproc proc1 ON proc1.amprocfamily = c.opcfamily AND proc1.amprocnum = 1
                         AND proc1.amproclefttype = c.opcintype AND proc1.amprocrighttype = c.opcintype
     JOIN pg_amproc proc2 ON proc2.amprocfamily = c.opcfamily AND proc2.amprocnum = 2
                         AND proc2.amproclefttype = c.opcintype AND proc2.amprocrighttype = c.opcintype
WHERE a.amname = 'hash' AND c.opcintype = 'timestamptz'::regtype AND c.opcdefault;
 hash_function_as_expected | extended_function_as_expected 
---------------------------+-------------------------------
 t                         | t
(1 row)

-- IS DISTINCT FROM: a NULL from the lookup counts as a mismatch instead of passing
SELECT count(*) AS values,
       count(*) FILTER (WHERE jtimestamptz_hash(v)::bigint IS DISTINCT FROM pg_temp.core_tz_hash(v::timestamptz)) AS hash_mismatches,
       count(*) FILTER (WHERE jtimestamptz_hash_extended(v, 7) IS DISTINCT FROM pg_temp.core_tz_hash(v::timestamptz, 7)) AS ext_hash_mismatches,
       count(*) FILTER (WHERE (jtimestamptz_hash_extended(v, 0) & 4294967295) <> (jtimestamptz_hash(v)::bigint & 4294967295)) AS seed0_mismatches,
       count(*) FILTER (WHERE jtimestamptz_hash_extended(v, 1) <> jtimestamptz_hash_extended(v, 0)) > 0 AS seed_changes_hash
FROM jt_ops_tz;
 values | hash_mismatches | ext_hash_mismatches | seed0_mismatches | seed_changes_hash 
--------+-----------------+---------------------+------------------+-------------------
     11 |               0 |                   0 |                0 | t
(1 row)

-- ---------------------------------------------------------------------
-- Hash Join and HashAggregate give the same rows as the sort-based plans:
-- a has 300 distinct values, three rows each, plus both infinities;
-- b has every second value for 400 values, plus both infinities
-- ---------------------------------------------------------------------
CREATE TEMP TABLE jt_ops_ja_tz (v jtimestamptz, n int);
CREATE TEMP TABLE jt_ops_jb_tz (v jtimestamptz, m int);
INSERT INTO jt_ops_ja_tz SELECT ('2024-03-20 00:00:00+00'::timestamptz + (g % 300) * interval '1 hour')::jtimestamptz, g FROM generate_series(0, 899) g;
INSERT INTO jt_ops_jb_tz SELECT ('2024-03-20 00:00:00+00'::timestamptz + (g * 2) * interval '1 hour')::jtimestamptz, g FROM generate_series(0, 199) g;
INSERT INTO jt_ops_ja_tz VALUES ('infinity', 1000), ('-infinity', 1001);
INSERT INTO jt_ops_jb_tz VALUES ('infinity', 2000), ('-infinity', 2001);
ANALYZE jt_ops_ja_tz;
ANALYZE jt_ops_jb_tz;
CREATE TEMP TABLE jt_ops_jres_tz (method text, join_rows bigint, checksum bigint);
SET enable_mergejoin = off;
SET enable_nestloop = off;
SELECT bool_or(l ~ '^Hash Join') AS hash_join_planned
FROM jt_ops_plan('SELECT * FROM jt_ops_ja_tz a JOIN jt_ops_jb_tz b ON a.v = b.v') l;
 hash_join_planned 
-------------------
 t
(1 row)

INSERT INTO jt_ops_jres_tz
SELECT 'hash', count(*), sum(a.n + b.m) FROM jt_ops_ja_tz a JOIN jt_ops_jb_tz b ON a.v = b.v;
RESET enable_mergejoin;
RESET enable_nestloop;
SET enable_hashjoin = off;
SET enable_nestloop = off;
SELECT bool_or(l ~ '^Merge Join') AS merge_join_planned
FROM jt_ops_plan('SELECT * FROM jt_ops_ja_tz a JOIN jt_ops_jb_tz b ON a.v = b.v') l;
 merge_join_planned 
--------------------
 t
(1 row)

INSERT INTO jt_ops_jres_tz
SELECT 'merge', count(*), sum(a.n + b.m) FROM jt_ops_ja_tz a JOIN jt_ops_jb_tz b ON a.v = b.v;
RESET enable_hashjoin;
RESET enable_nestloop;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SELECT bool_or(l ~ '^Nested Loop') AS nested_loop_planned
FROM jt_ops_plan('SELECT * FROM jt_ops_ja_tz a JOIN jt_ops_jb_tz b ON a.v = b.v') l;
 nested_loop_planned 
---------------------
 t
(1 row)

INSERT INTO jt_ops_jres_tz
SELECT 'nestloop', count(*), sum(a.n + b.m) FROM jt_ops_ja_tz a JOIN jt_ops_jb_tz b ON a.v = b.v;
RESET enable_hashjoin;
RESET enable_mergejoin;
SELECT method, join_rows, checksum FROM jt_ops_jres_tz ORDER BY method;
  method  | join_rows | checksum 
----------+-----------+----------
 hash     |       452 |   241577
 merge    |       452 |   241577
 nestloop |       452 |   241577
