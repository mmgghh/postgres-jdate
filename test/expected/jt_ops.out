                1
(1 row)

CREATE TEMP TABLE jt_ops_ares_tz (method text, grp bigint, total bigint, biggest bigint);
SET enable_sort = off;
SELECT bool_or(l ~ '^HashAggregate') AS hash_aggregate_planned
