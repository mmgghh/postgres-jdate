-- Cross-type comparison between jdate, jtimestamp and jtimestamptz: the six
-- operators for each of the six ordered pairs, their catalog entries, the
-- shared btree family jdatetime_ops (45 operators, `<>` outside it), merge
-- joins and index scans across the types, and what must still fail. Results
-- are checked against core's operators on the same values converted to
-- date / timestamp / timestamptz, and against an independent oracle (the
-- instants as exact epoch numbers). Errors are shown as SQLSTATE only; plans
-- are never printed, only booleans taken from them.
--
-- Everything created here is temporary or dropped at the end: extension_schema
-- runs DROP EXTENSION, which needs no column of our types left behind.
SET DateStyle = 'ISO, YMD';
SET timezone = 'UTC';
-- no JIT: compiling the matrix function below takes about a second per call
-- (the 7 zone runs), running it takes milliseconds
SET jit = off;
\set VERBOSITY sqlstate
-- EXPLAIN node lines with the indentation and "->" stripped, so the test can
-- turn the plan into booleans without printing it.
CREATE FUNCTION jt_cx_plan(query text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
    line text;
BEGIN
    FOR line IN EXECUTE 'EXPLAIN (COSTS off) ' || query LOOP
        RETURN NEXT regexp_replace(line, '^[ ]*(->)?[ ]*', '');
    END LOOP;
END
$$;
-- ---------------------------------------------------------------------
-- the operators in the catalog: 6 per operator name, one per ordered pair
-- ---------------------------------------------------------------------
-- estimators and flags per operator name: `=` merges but does not hash
SELECT o.oprname AS operator,
       o.oprrest::regproc AS restrict, o.oprjoin::regproc AS join_estimator,
       o.oprcanhash AS hashes, o.oprcanmerge AS merges,
       c.oprname AS commutator, n.oprname AS negator,
       count(*) AS pairs
FROM pg_operator o
LEFT JOIN pg_operator c ON c.oid = o.oprcom
LEFT JOIN pg_operator n ON n.oid = o.oprnegate
WHERE o.oprleft <> o.oprright
  AND o.oprname IN ('=', '<>', '<', '<=', '>', '>=')
  AND o.oprleft IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
  AND o.oprright IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
GROUP BY 1, 2, 3, 4, 5, 6, 7
ORDER BY o.oprname COLLATE "C";
 operator |    restrict     | join_estimator  | hashes | merges | commutator | negator | pairs 
----------+-----------------+-----------------+--------+--------+------------+---------+-------
 <        | jdatetime_ltsel | scalarltjoinsel | f      | f      | >          | >=      |     6
 <=       | jdatetime_lesel | scalarlejoinsel | f      | f      | >=         | >       |     6
 <>       | neqsel          | neqjoinsel      | f      | f      | <>         | =       |     6
 =        | eqsel           | eqjoinsel       | f      | t      | =          | <>      |     6
 >        | jdatetime_gtsel | scalargtjoinsel | f      | f      | <          | <=      |     6
 >=       | jdatetime_gesel | scalargejoinsel | f      | f      | <=         | <       |     6
(6 rows)

-- every cross-type operator has its commutator on the reversed pair and its
-- negator on the same pair, and both point back
SELECT count(*) AS operators,
       count(*) FILTER (WHERE c.oprleft = o.oprright AND c.oprright = o.oprleft
                          AND c.oprcom = o.oid) AS commutators_on_reversed_pair,
       count(*) FILTER (WHERE n.oprleft = o.oprleft AND n.oprright = o.oprright
                          AND n.oprnegate = o.oid) AS negators_on_same_pair
FROM pg_operator o
JOIN pg_operator c ON c.oid = o.oprcom
JOIN pg_operator n ON n.oid = o.oprnegate
WHERE o.oprleft <> o.oprright
  AND o.oprname IN ('=', '<>', '<', '<=', '>', '>=')
  AND o.oprleft IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
  AND o.oprright IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype);
 operators | commutators_on_reversed_pair | negators_on_same_pair 
-----------+------------------------------+-----------------------
        36 |                           36 |                    36
(1 row)

-- the functions: 7 per ordered pair (six operators and cmp), STABLE where the
-- pair involves jtimestamptz and a type without a zone, IMMUTABLE for jdate
-- against jtimestamp; always STRICT, PARALLEL SAFE and C functions
SELECT s.left_type, s.right_type, s.volatility, s.parallel, s.strict, s.language, s.functions
FROM (SELECT p.proargtypes[0]::regtype::text AS left_type, p.proargtypes[1]::regtype::text AS right_type,
             p.provolatile AS volatility, p.proparallel AS parallel, p.proisstrict AS strict,
             l.lanname AS language, count(*) AS functions
      FROM pg_proc p JOIN pg_language l ON l.oid = p.prolang
      WHERE p.pronargs = 2 AND p.proargtypes[0] <> p.proargtypes[1]
        AND p.proargtypes[0] IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
        AND p.proargtypes[1] IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
        AND p.proname ~ '_(eq|ne|lt|le|gt|ge|cmp)_'
      GROUP BY 1, 2, 3, 4, 5, 6) s
ORDER BY s.left_type COLLATE "C", s.right_type COLLATE "C";
  left_type   |  right_type  | volatility | parallel | strict | language | functions 
--------------+--------------+------------+----------+--------+----------+-----------
 jdate        | jtimestamp   | i          | s        | t      | c        |         7
 jdate        | jtimestamptz | s          | s        | t      | c        |         7
 jtimestamp   | jdate        | i          | s        | t      | c        |         7
 jtimestamp   | jtimestamptz | s          | s        | t      | c        |         7
 jtimestamptz | jdate        | s          | s        | t      | c        |         7
 jtimestamptz | jtimestamp   | s          | s        | t      | c        |         7
(6 rows)

-- the operator functions return bool, the cmp functions int4
SELECT s.function, s.returns, s.pairs
FROM (SELECT regexp_replace(p.proname, '^.*_(eq|ne|lt|le|gt|ge|cmp)_.*$', '\1') AS function,
             p.prorettype::regtype AS returns, count(*) AS pairs
      FROM pg_proc p
      WHERE p.pronargs = 2 AND p.proargtypes[0] <> p.proargtypes[1]
        AND p.proargtypes[0] IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
        AND p.proargtypes[1] IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
        AND p.proname ~ '_(eq|ne|lt|le|gt|ge|cmp)_'
      GROUP BY 1, 2) s
ORDER BY s.function COLLATE "C";
 function | returns | pairs 
----------+---------+-------
 cmp      | integer |     6
 eq       | boolean |     6
 ge       | boolean |     6
 gt       | boolean |     6
 le       | boolean |     6
 lt       | boolean |     6
 ne       | boolean |     6
(7 rows)

-- each operator runs the function of its own name and pair, and the volatility
-- rule holds for the operator functions: the volatility of the function is
-- the one the pair calls for
SELECT count(*) AS operators,
       count(*) FILTER (WHERE p.proname = format('%s_%s_%s',
              o.oprleft::regtype,
              CASE o.oprname WHEN '=' THEN 'eq' WHEN '<>' THEN 'ne' WHEN '<' THEN 'lt'
                             WHEN '<=' THEN 'le' WHEN '>' THEN 'gt' ELSE 'ge' END,
              o.oprright::regtype)) AS function_named_for_the_pair,
       count(*) FILTER (WHERE p.provolatile = CASE WHEN 'jtimestamptz'::regtype IN (o.oprleft, o.oprright)
                                                   THEN 's' ELSE 'i' END) AS volatility_as_expected
FROM pg_operator o JOIN pg_proc p ON p.oid = o.oprcode
WHERE o.oprleft <> o.oprright
  AND o.oprname IN ('=', '<>', '<', '<=', '>', '>=')
  AND o.oprleft IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
  AND o.oprright IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype);
 operators | function_named_for_the_pair | volatility_as_expected 
-----------+-----------------------------+------------------------
        36 |                          36 |                     36
(1 row)

-- ---------------------------------------------------------------------
-- the btree family jdatetime_ops: 45 operators, 9 `<>` outside it
-- ---------------------------------------------------------------------
-- three same-type entries and six cross-type entries, five operators each
SELECT amoplefttype::regtype AS left_type, amoprighttype::regtype AS right_type,
       array_agg(amopstrategy ORDER BY amopstrategy) AS strategies,
       array_agg(amopopr::regoperator::text ORDER BY amopstrategy) AS operators
FROM pg_amop
WHERE amopfamily = (SELECT oid FROM pg_opfamily WHERE opfname = 'jdatetime_ops'
                    AND opfmethod = (SELECT oid FROM pg_am WHERE amname = 'btree'))
GROUP BY amoplefttype, amoprighttype
ORDER BY amoplefttype::regtype::text COLLATE "C", amoprighttype::regtype::text COLLATE "C";
  left_type   |  right_type  | strategies  |                                                                           operators                                                                            
--------------+--------------+-------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------
 jdate        | jdate        | {1,2,3,4,5} | {"<(jdate,jdate)","<=(jdate,jdate)","=(jdate,jdate)",">=(jdate,jdate)",">(jdate,jdate)"}
 jdate        | jtimestamp   | {1,2,3,4,5} | {"<(jdate,jtimestamp)","<=(jdate,jtimestamp)","=(jdate,jtimestamp)",">=(jdate,jtimestamp)",">(jdate,jtimestamp)"}
 jdate        | jtimestamptz | {1,2,3,4,5} | {"<(jdate,jtimestamptz)","<=(jdate,jtimestamptz)","=(jdate,jtimestamptz)",">=(jdate,jtimestamptz)",">(jdate,jtimestamptz)"}
 jtimestamp   | jdate        | {1,2,3,4,5} | {"<(jtimestamp,jdate)","<=(jtimestamp,jdate)","=(jtimestamp,jdate)",">=(jtimestamp,jdate)",">(jtimestamp,jdate)"}
 jtimestamp   | jtimestamp   | {1,2,3,4,5} | {"<(jtimestamp,jtimestamp)","<=(jtimestamp,jtimestamp)","=(jtimestamp,jtimestamp)",">=(jtimestamp,jtimestamp)",">(jtimestamp,jtimestamp)"}
 jtimestamp   | jtimestamptz | {1,2,3,4,5} | {"<(jtimestamp,jtimestamptz)","<=(jtimestamp,jtimestamptz)","=(jtimestamp,jtimestamptz)",">=(jtimestamp,jtimestamptz)",">(jtimestamp,jtimestamptz)"}
 jtimestamptz | jdate        | {1,2,3,4,5} | {"<(jtimestamptz,jdate)","<=(jtimestamptz,jdate)","=(jtimestamptz,jdate)",">=(jtimestamptz,jdate)",">(jtimestamptz,jdate)"}
 jtimestamptz | jtimestamp   | {1,2,3,4,5} | {"<(jtimestamptz,jtimestamp)","<=(jtimestamptz,jtimestamp)","=(jtimestamptz,jtimestamp)",">=(jtimestamptz,jtimestamp)",">(jtimestamptz,jtimestamp)"}
 jtimestamptz | jtimestamptz | {1,2,3,4,5} | {"<(jtimestamptz,jtimestamptz)","<=(jtimestamptz,jtimestamptz)","=(jtimestamptz,jtimestamptz)",">=(jtimestamptz,jtimestamptz)",">(jtimestamptz,jtimestamptz)"}
(9 rows)

-- the totals: 45 operators in the family, nine per strategy, every one a
-- search operator of the family (not ordering); the nine `<>` operators of
-- the three types (3 same-type, 6 cross-type) are none of them in it
SELECT count(*) AS family_operators,
       count(DISTINCT amopopr) AS distinct_operators,
       count(*) FILTER (WHERE amoppurpose = 's') AS search_operators,
       (SELECT count(*) FROM pg_operator o
        WHERE o.oprname = '<>'
          AND o.oprleft IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)
          AND o.oprright IN ('jdate'::regtype, 'jtimestamp'::regtype, 'jtimestamptz'::regtype)) AS not_equal_operators,
       (SELECT count(*) FROM pg_amop a JOIN pg_operator o ON o.oid = a.amopopr
        WHERE a.amopfamily = f.oid AND o.oprname = '<>') AS not_equal_in_family
FROM pg_amop m, (SELECT oid FROM pg_opfamily WHERE opfname = 'jdatetime_ops'
                 AND opfmethod = (SELECT oid FROM pg_am WHERE amname = 'btree')) f
WHERE m.amopfamily = f.oid
GROUP BY f.oid;
 family_operators | distinct_operators | search_operators | not_equal_operators | not_equal_in_family 
------------------+--------------------+------------------+---------------------+---------------------
               45 |                 45 |               45 |                   9 |                   0
(1 row)

SELECT amopstrategy AS strategy, count(*) AS operators
FROM pg_amop
WHERE amopfamily = (SELECT oid FROM pg_opfamily WHERE opfname = 'jdatetime_ops'
                    AND opfmethod = (SELECT oid FROM pg_am WHERE amname = 'btree'))
GROUP BY 1 ORDER BY 1;
 strategy | operators 
----------+-----------
        1 |         9
        2 |         9
        3 |         9
        4 |         9
        5 |         9
(5 rows)

-- every cross-type entry has exactly support function 1, its own cmp function
-- (no sort support, equalimage or skip support: those are same-type entries)
SELECT amproclefttype::regtype AS left_type, amprocrighttype::regtype AS right_type,
       array_agg(amprocnum ORDER BY amprocnum) AS numbers,
       array_agg(amproc::regprocedure::text ORDER BY amprocnum) AS functions
FROM pg_amproc
WHERE amprocfamily = (SELECT oid FROM pg_opfamily WHERE opfname = 'jdatetime_ops'
                      AND opfmethod = (SELECT oid FROM pg_am WHERE amname = 'btree'))
  AND amproclefttype <> amprocrighttype
GROUP BY amproclefttype, amprocrighttype
ORDER BY amproclefttype::regtype::text COLLATE "C", amprocrighttype::regtype::text COLLATE "C";
  left_type   |  right_type  | numbers |                        functions                         
--------------+--------------+---------+----------------------------------------------------------
 jdate        | jtimestamp   | {1}     | {"jdate_cmp_jtimestamp(jdate,jtimestamp)"}
 jdate        | jtimestamptz | {1}     | {"jdate_cmp_jtimestamptz(jdate,jtimestamptz)"}
 jtimestamp   | jdate        | {1}     | {"jtimestamp_cmp_jdate(jtimestamp,jdate)"}
 jtimestamp   | jtimestamptz | {1}     | {"jtimestamp_cmp_jtimestamptz(jtimestamp,jtimestamptz)"}
 jtimestamptz | jdate        | {1}     | {"jtimestamptz_cmp_jdate(jtimestamptz,jdate)"}
 jtimestamptz | jtimestamp   | {1}     | {"jtimestamptz_cmp_jtimestamp(jtimestamptz,jtimestamp)"}
(6 rows)

-- the whole family validates: amvalidate accepts all three btree classes (it
-- reports a missing cross-type operator or function as a message and false)
SELECT c.opcname AS class, c.opcintype::regtype AS type, amvalidate(c.oid) AS valid
FROM pg_opclass c
JOIN pg_opfamily f ON f.oid = c.opcfamily
WHERE f.opfname = 'jdatetime_ops'
ORDER BY c.opcname COLLATE "C";
      class       |     type     | valid 
------------------+--------------+-------
 jdate_ops        | jdate        | t
 jtimestamp_ops   | jtimestamp   | t
 jtimestamptz_ops | jtimestamptz | t
(3 rows)

-- ---------------------------------------------------------------------
-- the values: edges, infinities, equal values written differently and, for
-- jtimestamptz, the same local midnight of Nowruz 1403 (2024-03-20) in the
-- offsets of the zones used below. `c` is the same value as the core type;
-- it never errs, so it is the oracle for what the operators say.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE jt_cx_d (id int PRIMARY KEY, v jdate, c date);
INSERT INTO jt_cx_d (id, v)
SELECT row_number() OVER (), x FROM (VALUES
    ('-infinity'::jdate), ('-0061-01-01'), ('-0061-01-02'), ('1402-12-29'), ('1403-01-01'),
    ('1403-01-02'), ('3177-12-28'), ('3177-12-29'), ('infinity')) t(x);
UPDATE jt_cx_d SET c = v::date;
CREATE TEMP TABLE jt_cx_ts (id int PRIMARY KEY, v jtimestamp, c timestamp);
INSERT INTO jt_cx_ts (id, v)
SELECT row_number() OVER (), x FROM (VALUES
    ('-infinity'::jtimestamp), ('-0061-01-01 00:00:00'), ('-0061-01-01 00:00:00.000001'),
    ('-0061-01-02 00:00:00'), ('1402-12-29 23:59:59.999999'), ('1403-01-01 00:00:00'),
    ('1403-01-01 00:00:00.000001'), ('1403-01-01 12:00:00'), ('1403-01-02 00:00:00'),
    ('3177-12-28 23:59:59.999999'), ('3177-12-29 00:00:00'), ('3177-12-29 23:59:59.999999'),
    ('infinity')) t(x);
UPDATE jt_cx_ts SET c = v::timestamp;
-- jtimestamptz values carry their offset, so they are the same instants under
-- every session zone: the first and last valid instants, the instants one
-- microsecond around Nowruz, and 1403-01-01 00:00:00 in each zone's offset
CREATE TEMP TABLE jt_cx_tz (id int PRIMARY KEY, v jtimestamptz, c timestamptz);
INSERT INTO jt_cx_tz (id, v)
SELECT row_number() OVER (), x FROM (VALUES
    ('-infinity'::jtimestamptz), ('-0061-01-01 16:00:00+00'), ('-0061-01-01 16:00:00.000001+00'),
    ('1402-12-29 23:59:59.999999+00'), ('1403-01-01 00:00:00+00'), ('1403-01-01 00:00:00.000001+00'),
    ('1403-01-01 00:00:00+03:30'), ('1403-01-01 00:00:00-04'), ('1403-01-01 00:00:00+14'),
    ('1403-01-01 00:00:00-11'), ('1403-01-01 00:00:00+15:59'), ('1403-01-01 00:00:00-15:59'),
    ('1403-01-01 12:00:00+00'), ('1403-01-02 00:00:00+00'), ('3177-12-29 07:59:59.999999+00'),
    ('infinity')) t(x);
UPDATE jt_cx_tz SET c = v::timestamptz;
SELECT (SELECT count(*) FROM jt_cx_d) AS jdate_values,
       (SELECT count(*) FROM jt_cx_ts) AS jtimestamp_values,
       (SELECT count(*) FROM jt_cx_tz) AS jtimestamptz_values;
 jdate_values | jtimestamp_values | jtimestamptz_values 
--------------+-------------------+---------------------
            9 |                13 |                  16
(1 row)

-- ---------------------------------------------------------------------
-- the matrix: every ordered pair, every operator and the cmp function, over
-- all value pairs, per session zone. Per pair and zone:
--   core_mism     operator result differs from core's operator on the core values
--   epoch_mism    operator result differs from comparing the exact epoch numbers of
--                 the two instants (a zone-free value sits on the time line in
--                 the session zone, as core places it)
--   algebra_mism  `=` and `<>`, `<` and `>=`, `<=` and `>` not exact opposites,
--                 not exactly one of `<`, `=`, `>`, or the reversed pair disagrees
--                 (the commutator: a < b is b > a, ...)
--   cmp_mism      the cmp function is not -1, 0, 1 for less, equal, greater
-- all of them must be 0; eq, lt and gt count the true results (so the rows are
-- not vacuous) and sig is a hash of the whole result matrix.
-- ---------------------------------------------------------------------
CREATE FUNCTION jt_cx_matrix() RETURNS TABLE (zone text, pair text, pairs bigint, core_mism bigint,
    epoch_mism bigint, algebra_mism bigint, cmp_mism bigint, eq bigint, lt bigint, gt bigint, sig text)
LANGUAGE sql AS $$
    SELECT current_setting('TimeZone'), 'jdate/jtimestamp', count(*),
           count(*) FILTER (WHERE (a.v = b.v) <> (a.c = b.c) OR (a.v <> b.v) <> (a.c <> b.c)
                               OR (a.v < b.v) <> (a.c < b.c) OR (a.v <= b.v) <> (a.c <= b.c)
                               OR (a.v > b.v) <> (a.c > b.c) OR (a.v >= b.v) <> (a.c >= b.c)),
           count(*) FILTER (WHERE (a.v = b.v) <> (k.ka = k.kb) OR (a.v <> b.v) <> (k.ka <> k.kb)
                               OR (a.v < b.v) <> (k.ka < k.kb) OR (a.v <= b.v) <> (k.ka <= k.kb)
                               OR (a.v > b.v) <> (k.ka > k.kb) OR (a.v >= b.v) <> (k.ka >= k.kb)),
           count(*) FILTER (WHERE (a.v = b.v) = (a.v <> b.v) OR (a.v < b.v) = (a.v >= b.v)
                               OR (a.v <= b.v) = (a.v > b.v)
                               OR (a.v < b.v)::int + (a.v = b.v)::int + (a.v > b.v)::int <> 1
                               OR (a.v = b.v) <> (b.v = a.v) OR (a.v <> b.v) <> (b.v <> a.v)
                               OR (a.v < b.v) <> (b.v > a.v) OR (a.v <= b.v) <> (b.v >= a.v)
                               OR (a.v > b.v) <> (b.v < a.v) OR (a.v >= b.v) <> (b.v <= a.v)),
           count(*) FILTER (WHERE jdate_cmp_jtimestamp(a.v, b.v) <> CASE WHEN k.ka < k.kb THEN -1 WHEN k.ka > k.kb THEN 1 ELSE 0 END),
           count(*) FILTER (WHERE a.v = b.v), count(*) FILTER (WHERE a.v < b.v), count(*) FILTER (WHERE a.v > b.v),
           md5(string_agg((a.v < b.v)::int::text || (a.v = b.v)::int::text || (a.v > b.v)::int::text, ',' ORDER BY a.id, b.id))
    FROM jt_cx_d a CROSS JOIN jt_cx_ts b
         CROSS JOIN LATERAL (SELECT extract(epoch from a.c::timestamp) AS ka, extract(epoch from b.c) AS kb) k
    UNION ALL
    SELECT current_setting('TimeZone'), 'jtimestamp/jdate', count(*),
           count(*) FILTER (WHERE (a.v = b.v) <> (a.c = b.c) OR (a.v <> b.v) <> (a.c <> b.c)
                               OR (a.v < b.v) <> (a.c < b.c) OR (a.v <= b.v) <> (a.c <= b.c)
                               OR (a.v > b.v) <> (a.c > b.c) OR (a.v >= b.v) <> (a.c >= b.c)),
           count(*) FILTER (WHERE (a.v = b.v) <> (k.ka = k.kb) OR (a.v <> b.v) <> (k.ka <> k.kb)
                               OR (a.v < b.v) <> (k.ka < k.kb) OR (a.v <= b.v) <> (k.ka <= k.kb)
                               OR (a.v > b.v) <> (k.ka > k.kb) OR (a.v >= b.v) <> (k.ka >= k.kb)),
           count(*) FILTER (WHERE (a.v = b.v) = (a.v <> b.v) OR (a.v < b.v) = (a.v >= b.v)
                               OR (a.v <= b.v) = (a.v > b.v)
                               OR (a.v < b.v)::int + (a.v = b.v)::int + (a.v > b.v)::int <> 1
                               OR (a.v = b.v) <> (b.v = a.v) OR (a.v <> b.v) <> (b.v <> a.v)
                               OR (a.v < b.v) <> (b.v > a.v) OR (a.v <= b.v) <> (b.v >= a.v)
                               OR (a.v > b.v) <> (b.v < a.v) OR (a.v >= b.v) <> (b.v <= a.v)),
           count(*) FILTER (WHERE jtimestamp_cmp_jdate(a.v, b.v) <> CASE WHEN k.ka < k.kb THEN -1 WHEN k.ka > k.kb THEN 1 ELSE 0 END),
           count(*) FILTER (WHERE a.v = b.v), count(*) FILTER (WHERE a.v < b.v), count(*) FILTER (WHERE a.v > b.v),
           md5(string_agg((a.v < b.v)::int::text || (a.v = b.v)::int::text || (a.v > b.v)::int::text, ',' ORDER BY a.id, b.id))
    FROM jt_cx_ts a CROSS JOIN jt_cx_d b
         CROSS JOIN LATERAL (SELECT extract(epoch from a.c) AS ka, extract(epoch from b.c::timestamp) AS kb) k
    UNION ALL
    SELECT current_setting('TimeZone'), 'jdate/jtimestamptz', count(*),
           count(*) FILTER (WHERE (a.v = b.v) <> (a.c = b.c) OR (a.v <> b.v) <> (a.c <> b.c)
                               OR (a.v < b.v) <> (a.c < b.c) OR (a.v <= b.v) <> (a.c <= b.c)
                               OR (a.v > b.v) <> (a.c > b.c) OR (a.v >= b.v) <> (a.c >= b.c)),
           count(*) FILTER (WHERE (a.v = b.v) <> (k.ka = k.kb) OR (a.v <> b.v) <> (k.ka <> k.kb)
                               OR (a.v < b.v) <> (k.ka < k.kb) OR (a.v <= b.v) <> (k.ka <= k.kb)
                               OR (a.v > b.v) <> (k.ka > k.kb) OR (a.v >= b.v) <> (k.ka >= k.kb)),
           count(*) FILTER (WHERE (a.v = b.v) = (a.v <> b.v) OR (a.v < b.v) = (a.v >= b.v)
                               OR (a.v <= b.v) = (a.v > b.v)
                               OR (a.v < b.v)::int + (a.v = b.v)::int + (a.v > b.v)::int <> 1
                               OR (a.v = b.v) <> (b.v = a.v) OR (a.v <> b.v) <> (b.v <> a.v)
                               OR (a.v < b.v) <> (b.v > a.v) OR (a.v <= b.v) <> (b.v >= a.v)
                               OR (a.v > b.v) <> (b.v < a.v) OR (a.v >= b.v) <> (b.v <= a.v)),
           count(*) FILTER (WHERE jdate_cmp_jtimestamptz(a.v, b.v) <> CASE WHEN k.ka < k.kb THEN -1 WHEN k.ka > k.kb THEN 1 ELSE 0 END),
           count(*) FILTER (WHERE a.v = b.v), count(*) FILTER (WHERE a.v < b.v), count(*) FILTER (WHERE a.v > b.v),
           md5(string_agg((a.v < b.v)::int::text || (a.v = b.v)::int::text || (a.v > b.v)::int::text, ',' ORDER BY a.id, b.id))
    FROM jt_cx_d a CROSS JOIN jt_cx_tz b
         CROSS JOIN LATERAL (SELECT extract(epoch from a.c::timestamptz) AS ka, extract(epoch from b.c) AS kb) k
    UNION ALL
    SELECT current_setting('TimeZone'), 'jtimestamptz/jdate', count(*),
           count(*) FILTER (WHERE (a.v = b.v) <> (a.c = b.c) OR (a.v <> b.v) <> (a.c <> b.c)
                               OR (a.v < b.v) <> (a.c < b.c) OR (a.v <= b.v) <> (a.c <= b.c)
                               OR (a.v > b.v) <> (a.c > b.c) OR (a.v >= b.v) <> (a.c >= b.c)),
           count(*) FILTER (WHERE (a.v = b.v) <> (k.ka = k.kb) OR (a.v <> b.v) <> (k.ka <> k.kb)
                               OR (a.v < b.v) <> (k.ka < k.kb) OR (a.v <= b.v) <> (k.ka <= k.kb)
                               OR (a.v > b.v) <> (k.ka > k.kb) OR (a.v >= b.v) <> (k.ka >= k.kb)),
           count(*) FILTER (WHERE (a.v = b.v) = (a.v <> b.v) OR (a.v < b.v) = (a.v >= b.v)
                               OR (a.v <= b.v) = (a.v > b.v)
                               OR (a.v < b.v)::int + (a.v = b.v)::int + (a.v > b.v)::int <> 1
                               OR (a.v = b.v) <> (b.v = a.v) OR (a.v <> b.v) <> (b.v <> a.v)
                               OR (a.v < b.v) <> (b.v > a.v) OR (a.v <= b.v) <> (b.v >= a.v)
                               OR (a.v > b.v) <> (b.v < a.v) OR (a.v >= b.v) <> (b.v <= a.v)),
           count(*) FILTER (WHERE jtimestamptz_cmp_jdate(a.v, b.v) <> CASE WHEN k.ka < k.kb THEN -1 WHEN k.ka > k.kb THEN 1 ELSE 0 END),
           count(*) FILTER (WHERE a.v = b.v), count(*) FILTER (WHERE a.v < b.v), count(*) FILTER (WHERE a.v > b.v),
           md5(string_agg((a.v < b.v)::int::text || (a.v = b.v)::int::text || (a.v > b.v)::int::text, ',' ORDER BY a.id, b.id))
    FROM jt_cx_tz a CROSS JOIN jt_cx_d b
         CROSS JOIN LATERAL (SELECT extract(epoch from a.c) AS ka, extract(epoch from b.c::timestamptz) AS kb) k
    UNION ALL
    SELECT current_setting('TimeZone'), 'jtimestamp/jtimestamptz', count(*),
           count(*) FILTER (WHERE (a.v = b.v) <> (a.c = b.c) OR (a.v <> b.v) <> (a.c <> b.c)
                               OR (a.v < b.v) <> (a.c < b.c) OR (a.v <= b.v) <> (a.c <= b.c)
                               OR (a.v > b.v) <> (a.c > b.c) OR (a.v >= b.v) <> (a.c >= b.c)),
           count(*) FILTER (WHERE (a.v = b.v) <> (k.ka = k.kb) OR (a.v <> b.v) <> (k.ka <> k.kb)
                               OR (a.v < b.v) <> (k.ka < k.kb) OR (a.v <= b.v) <> (k.ka <= k.kb)
                               OR (a.v > b.v) <> (k.ka > k.kb) OR (a.v >= b.v) <> (k.ka >= k.kb)),
           count(*) FILTER (WHERE (a.v = b.v) = (a.v <> b.v) OR (a.v < b.v) = (a.v >= b.v)
                               OR (a.v <= b.v) = (a.v > b.v)
                               OR (a.v < b.v)::int + (a.v = b.v)::int + (a.v > b.v)::int <> 1
                               OR (a.v = b.v) <> (b.v = a.v) OR (a.v <> b.v) <> (b.v <> a.v)
                               OR (a.v < b.v) <> (b.v > a.v) OR (a.v <= b.v) <> (b.v >= a.v)
                               OR (a.v > b.v) <> (b.v < a.v) OR (a.v >= b.v) <> (b.v <= a.v)),
           count(*) FILTER (WHERE jtimestamp_cmp_jtimestamptz(a.v, b.v) <> CASE WHEN k.ka < k.kb THEN -1 WHEN k.ka > k.kb THEN 1 ELSE 0 END),
           count(*) FILTER (WHERE a.v = b.v), count(*) FILTER (WHERE a.v < b.v), count(*) FILTER (WHERE a.v > b.v),
           md5(string_agg((a.v < b.v)::int::text || (a.v = b.v)::int::text || (a.v > b.v)::int::text, ',' ORDER BY a.id, b.id))
    FROM jt_cx_ts a CROSS JOIN jt_cx_tz b
         CROSS JOIN LATERAL (SELECT extract(epoch from a.c::timestamptz) AS ka, extract(epoch from b.c) AS kb) k
    UNION ALL
    SELECT current_setting('TimeZone'), 'jtimestamptz/jtimestamp', count(*),
           count(*) FILTER (WHERE (a.v = b.v) <> (a.c = b.c) OR (a.v <> b.v) <> (a.c <> b.c)
                               OR (a.v < b.v) <> (a.c < b.c) OR (a.v <= b.v) <> (a.c <= b.c)
                               OR (a.v > b.v) <> (a.c > b.c) OR (a.v >= b.v) <> (a.c >= b.c)),
           count(*) FILTER (WHERE (a.v = b.v) <> (k.ka = k.kb) OR (a.v <> b.v) <> (k.ka <> k.kb)
                               OR (a.v < b.v) <> (k.ka < k.kb) OR (a.v <= b.v) <> (k.ka <= k.kb)
                               OR (a.v > b.v) <> (k.ka > k.kb) OR (a.v >= b.v) <> (k.ka >= k.kb)),
           count(*) FILTER (WHERE (a.v = b.v) = (a.v <> b.v) OR (a.v < b.v) = (a.v >= b.v)
                               OR (a.v <= b.v) = (a.v > b.v)
                               OR (a.v < b.v)::int + (a.v = b.v)::int + (a.v > b.v)::int <> 1
                               OR (a.v = b.v) <> (b.v = a.v) OR (a.v <> b.v) <> (b.v <> a.v)
                               OR (a.v < b.v) <> (b.v > a.v) OR (a.v <= b.v) <> (b.v >= a.v)
                               OR (a.v > b.v) <> (b.v < a.v) OR (a.v >= b.v) <> (b.v <= a.v)),
           count(*) FILTER (WHERE jtimestamptz_cmp_jtimestamp(a.v, b.v) <> CASE WHEN k.ka < k.kb THEN -1 WHEN k.ka > k.kb THEN 1 ELSE 0 END),
           count(*) FILTER (WHERE a.v = b.v), count(*) FILTER (WHERE a.v < b.v), count(*) FILTER (WHERE a.v > b.v),
           md5(string_agg((a.v < b.v)::int::text || (a.v = b.v)::int::text || (a.v > b.v)::int::text, ',' ORDER BY a.id, b.id))
    FROM jt_cx_tz a CROSS JOIN jt_cx_ts b
         CROSS JOIN LATERAL (SELECT extract(epoch from a.c) AS ka, extract(epoch from b.c::timestamptz) AS kb) k
$$;
CREATE TEMP TABLE jt_cx_res (zone_no int, zone text, pair text, pairs bigint, core_mism bigint,
    epoch_mism bigint, algebra_mism bigint, cmp_mism bigint, eq bigint, lt bigint, gt bigint, sig text);
SET timezone = 'UTC';
INSERT INTO jt_cx_res SELECT 1, * FROM jt_cx_matrix();
SET timezone = 'Asia/Tehran';
INSERT INTO jt_cx_res SELECT 2, * FROM jt_cx_matrix();
SET timezone = 'America/New_York';
INSERT INTO jt_cx_res SELECT 3, * FROM jt_cx_matrix();
SET timezone = 'Pacific/Kiritimati';
INSERT INTO jt_cx_res SELECT 4, * FROM jt_cx_matrix();
SET timezone = 'Pacific/Pago_Pago';
INSERT INTO jt_cx_res SELECT 5, * FROM jt_cx_matrix();
SET timezone = '<+15:59>-15:59';
INSERT INTO jt_cx_res SELECT 6, * FROM jt_cx_matrix();
SET timezone = '<-15:59>+15:59';
INSERT INTO jt_cx_res SELECT 7, * FROM jt_cx_matrix();
SET timezone = 'UTC';
-- (eq is the number of equal pairs: modern local midnights and the infinities,
-- so it does not depend on the tz database; the numbers of less and greater pairs
-- do for the named zones, where the year 560 has a local mean time, so they are
-- printed below only for the zones without one)
SELECT zone, pair, pairs, core_mism, epoch_mism, algebra_mism, cmp_mism, eq,
       lt > 0 AND gt > 0 AS both_orders
FROM jt_cx_res ORDER BY zone_no, pair COLLATE "C";
