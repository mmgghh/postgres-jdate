-- all mismatch counts are zero everywhere
SELECT count(*) AS rows, sum(pairs) AS value_pairs,
       sum(core_mism) AS core_mism, sum(epoch_mism) AS epoch_mism,
       sum(algebra_mism) AS algebra_mism, sum(cmp_mism) AS cmp_mism
FROM jt_cx_res;
