------+-------------+-----------+------------+--------------+----------
   42 |        6566 |         0 |          0 |            0 |        0
(1 row)

-- jdate against jtimestamp reads no zone (IMMUTABLE): the result is the same
-- in all seven zones. The pairs with jtimestamptz do read it: the results
-- differ between zones.
SELECT pair,
       count(DISTINCT sig) = 1 AS same_in_every_zone,
       count(DISTINCT sig) > 1 AS differs_between_zones
FROM jt_cx_res GROUP BY pair ORDER BY pair COLLATE "C";
          pair           | same_in_every_zone | differs_between_zones 
-------------------------+--------------------+-----------------------
 jdate/jtimestamp        | t                  | f
 jdate/jtimestamptz      | f                  | t
 jtimestamp/jdate        | t                  | f
 jtimestamp/jtimestamptz | f                  | t
 jtimestamptz/jdate      | f                  | t
 jtimestamptz/jtimestamp | f                  | t
(6 rows)

-- the pairs that are equal depend on the zone: the local midnight of 1403-01-01
-- as a jdate equals the jtimestamptz written with that zone's offset (and so
-- does 1403-01-02 in UTC, where such a value exists)
SELECT zone_no, zone, eq AS jdate_eq_jtimestamptz
FROM jt_cx_res WHERE pair = 'jdate/jtimestamptz' ORDER BY zone_no;
 zone_no |        zone        | jdate_eq_jtimestamptz 
---------+--------------------+-----------------------
       1 | UTC                |                     4
       2 | Asia/Tehran        |                     3
       3 | America/New_York   |                     3
       4 | Pacific/Kiritimati |                     3
       5 | Pacific/Pago_Pago  |                     3
       6 | <+15:59>-15:59     |                     3
       7 | <-15:59>+15:59     |                     3
(7 rows)

-- controls: the oracles can fail. The wrong operator against core's result and
-- against the epoch numbers shows mismatches, and a different zone on one side
-- of the epoch comparison does too
SELECT count(*) FILTER (WHERE (a.v < b.v) <> (a.c > b.c)) > 0 AS core_control_detects,
       count(*) FILTER (WHERE (a.v = b.v) <> (extract(epoch from a.c::timestamp) <> extract(epoch from b.c))) > 0
         AS epoch_control_detects
FROM jt_cx_d a CROSS JOIN jt_cx_ts b;
 core_control_detects | epoch_control_detects 
----------------------+-----------------------
 t                    | t
(1 row)

SELECT count(*) FILTER (WHERE (a.v = b.v) <>
           (extract(epoch from a.c::timestamptz AT TIME ZONE 'Asia/Tehran' AT TIME ZONE 'UTC') = extract(epoch from b.c)))
         > 0 AS zone_control_detects
FROM jt_cx_d a CROSS JOIN jt_cx_tz b;
 zone_control_detects 
----------------------
 t
(1 row)

-- ---------------------------------------------------------------------
-- NULL operands: every operator and the cmp function is STRICT
-- ---------------------------------------------------------------------
SELECT (NULL::jdate = '1403-01-01'::jtimestamp) IS NULL AS d_ts,
       ('1403-01-01'::jtimestamp < NULL::jdate) IS NULL AS ts_d,
       (NULL::jdate >= '1403-01-01 00:00:00+00'::jtimestamptz) IS NULL AS d_tz,
       ('1403-01-01 00:00:00+00'::jtimestamptz <> NULL::jdate) IS NULL AS tz_d,
       (NULL::jtimestamp > '1403-01-01 00:00:00+00'::jtimestamptz) IS NULL AS ts_tz,
       ('1403-01-01 00:00:00+00'::jtimestamptz <= NULL::jtimestamp) IS NULL AS tz_ts,
       jdate_cmp_jtimestamp(NULL, '1403-01-01') IS NULL AS cmp_null;
 d_ts | ts_d | d_tz | tz_d | ts_tz | tz_ts | cmp_null 
------+------+------+------+-------+-------+----------
 t    | t    | t    | t    | t     | t     | t
(1 row)

-- typmod values compare on what is stored
SELECT '1403-01-01 00:00:00.123456'::jtimestamp(3) = '1403-01-01 00:00:00.123'::jtimestamp AS ts_typmod_rounded,
       '1403-01-01 00:00:00.5+00'::jtimestamptz(0) > '1403-01-01'::jdate AS tz_typmod_rounded_up,
       '1403-01-01 00:00:00.4+00'::jtimestamptz(0) = '1403-01-01'::jdate AS tz_typmod_rounded_down;
 ts_typmod_rounded | tz_typmod_rounded_up | tz_typmod_rounded_down 
-------------------+----------------------+------------------------
 t                 | t                    | t
(1 row)

-- ---------------------------------------------------------------------
-- merge joins across the types. `=` is MERGES: with hash joins and nested
-- loops switched off the planner must still use a merge join, and the answer
-- must be the one core's operator gives on the core values. 400 days as jdate,
-- jtimestamp at 00:00, 08:00 and 16:00 of each of them, and jtimestamptz every
-- 30 minutes of the first 100 days.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE jt_cx_j_d AS
SELECT g AS id, (DATE '2024-03-20' + g)::jdate AS v, DATE '2024-03-20' + g AS c
FROM generate_series(0, 399) g;
CREATE TEMP TABLE jt_cx_j_ts AS
SELECT g AS id, t::jtimestamp AS v, t AS c
FROM (SELECT g, TIMESTAMP '2024-03-20 00:00:00' + g * interval '8 hours' AS t FROM generate_series(0, 1199) g) s;
CREATE TEMP TABLE jt_cx_j_tz AS
SELECT g AS id, t::jtimestamptz AS v, t AS c
FROM (SELECT g, TIMESTAMPTZ '2024-03-20 00:00:00+00' + g * interval '30 minutes' AS t FROM generate_series(0, 4799) g) s;
ANALYZE jt_cx_j_d;
ANALYZE jt_cx_j_ts;
ANALYZE jt_cx_j_tz;
-- one join per ordered pair of the tables whose ids are below lim: whether the
-- plan uses a merge join or a hash join, the number of rows, the oracle's number
-- of rows (core's operator on the core values) and whether the two results
-- are the same set of (left id, right id) pairs
CREATE FUNCTION jt_cx_join(l text, r text, lim int, OUT merge_join boolean, OUT hash_join boolean,
                           OUT join_rows bigint, OUT oracle_rows bigint, OUT same_rows boolean)
LANGUAGE plpgsql AS $$
DECLARE
    q text := format('SELECT a.id AS aid, b.id AS bid FROM jt_cx_j_%s a JOIN jt_cx_j_%s b ON a.v = b.v WHERE a.id < %s AND b.id < %s', l, r, lim, lim);
    oq text := format('SELECT a.id AS aid, b.id AS bid FROM jt_cx_j_%s a JOIN jt_cx_j_%s b ON a.c = b.c WHERE a.id < %s AND b.id < %s', l, r, lim, lim);
BEGIN
    SELECT bool_or(x ~ '^Merge Join'), bool_or(x ~ '^Hash Join') INTO merge_join, hash_join
    FROM jt_cx_plan(q) x;
    EXECUTE format('SELECT count(*), (SELECT count(*) FROM (%s) o),
                    NOT EXISTS ((SELECT aid, bid FROM (%s) s EXCEPT SELECT aid, bid FROM (%s) o)
                                UNION ALL (SELECT aid, bid FROM (%s) o EXCEPT SELECT aid, bid FROM (%s) s))
                    FROM (%s) s', oq, q, oq, oq, q, q)
        INTO join_rows, oracle_rows, same_rows;
END
$$;
SET enable_hashjoin = off;
SET enable_nestloop = off;
SELECT l || '/' || r AS pair, j.merge_join, j.hash_join, j.join_rows, j.oracle_rows, j.same_rows
FROM (VALUES (1, 'd', 'ts'), (2, 'ts', 'd'), (3, 'd', 'tz'), (4, 'tz', 'd'), (5, 'ts', 'tz'), (6, 'tz', 'ts')) v(n, l, r),
     LATERAL jt_cx_join(l, r, 100000) j
ORDER BY v.n;
 pair  | merge_join | hash_join | join_rows | oracle_rows | same_rows 
-------+------------+-----------+-----------+-------------+-----------
 d/ts  | t          | f         |       400 |         400 | t
 ts/d  | t          | f         |       400 |         400 | t
 d/tz  | t          | f         |       100 |         100 | t
 tz/d  | t          | f         |       100 |         100 | t
 ts/tz | t          | f         |       300 |         300 | t
 tz/ts | t          | f         |       300 |         300 | t
(6 rows)

RESET enable_hashjoin;
RESET enable_nestloop;
-- the same joins under the offset of Tehran (+03:30, as a fixed zone): the
-- zone-dependent pairs join other rows (a local midnight is another instant),
-- still the oracle's
SET timezone = '<+03:30>-03:30';
SET enable_hashjoin = off;
SET enable_nestloop = off;
SELECT l || '/' || r AS pair, j.merge_join, j.join_rows, j.oracle_rows, j.same_rows
FROM (VALUES (1, 'd', 'tz'), (2, 'tz', 'd'), (3, 'ts', 'tz'), (4, 'tz', 'ts')) v(n, l, r),
     LATERAL jt_cx_join(l, r, 100000) j
ORDER BY v.n;
 pair  | merge_join | join_rows | oracle_rows | same_rows 
-------+------------+-----------+-------------+-----------
 d/tz  | t          |       100 |         100 | t
 tz/d  | t          |       100 |         100 | t
 ts/tz | t          |       300 |         300 | t
 tz/ts | t          |       300 |         300 | t
(4 rows)

RESET enable_hashjoin;
RESET enable_nestloop;
SET timezone = 'UTC';
-- no hash join exists for these `=` (core has no cross-type hash either): with
-- merge joins and nested loops switched off the planner does not fail and does
-- not choose a hash join; the rows are still the oracle's (only the first 120
-- rows of each table: with a nested loop as the only way, the join is slow)
SET enable_mergejoin = off;
SET enable_nestloop = off;
SELECT l || '/' || r AS pair, j.hash_join, j.join_rows, j.oracle_rows, j.same_rows
FROM (VALUES (1, 'd', 'ts'), (2, 'ts', 'd'), (3, 'd', 'tz'), (4, 'tz', 'd'), (5, 'ts', 'tz'), (6, 'tz', 'ts')) v(n, l, r),
     LATERAL jt_cx_join(l, r, 120) j
ORDER BY v.n;
 pair  | hash_join | join_rows | oracle_rows | same_rows 
-------+-----------+-----------+-------------+-----------
 d/ts  | f         |        40 |          40 | t
 ts/d  | f         |        40 |          40 | t
 d/tz  | f         |         3 |           3 | t
 tz/d  | f         |         3 |           3 | t
 ts/tz | f         |         8 |           8 | t
 tz/ts | f         |         8 |           8 | t
(6 rows)

RESET enable_mergejoin;
RESET enable_nestloop;
-- ---------------------------------------------------------------------
-- index scans with a predicate of another type: an index on a column of one
-- type serves `<`, `<=`, `>=`, `>` against a value of another type of the
-- family, in either operand order. 20,000 rows per table with a btree index;
-- the predicate selects a narrow range two days wide.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE jt_cx_i_d AS
SELECT g AS id, (DATE '2024-03-20' + g % 2000)::jdate AS v, DATE '2024-03-20' + g % 2000 AS c
FROM generate_series(0, 19999) g;
CREATE TEMP TABLE jt_cx_i_ts AS
SELECT g AS id, t::jtimestamp AS v, t AS c
FROM (SELECT g, TIMESTAMP '2024-03-20 00:00:00' + g * interval '10 minutes' AS t FROM generate_series(0, 19999) g) s;
CREATE TEMP TABLE jt_cx_i_tz AS
SELECT g AS id, t::jtimestamptz AS v, t AS c
FROM (SELECT g, TIMESTAMPTZ '2024-03-20 00:00:00+00' + g * interval '10 minutes' AS t FROM generate_series(0, 19999) g) s;
CREATE INDEX jt_cx_i_d_idx ON jt_cx_i_d (v);
CREATE INDEX jt_cx_i_ts_idx ON jt_cx_i_ts (v);
CREATE INDEX jt_cx_i_tz_idx ON jt_cx_i_tz (v);
ANALYZE jt_cx_i_d;
ANALYZE jt_cx_i_ts;
ANALYZE jt_cx_i_tz;
-- whether the plan of a statement uses the index (a bitmap scan counts), with
-- sequential scans switched off for the function; the row count by that index
-- plan and by a sequential scan
CREATE FUNCTION jt_cx_index_plan(q text) RETURNS boolean
LANGUAGE plpgsql SET enable_seqscan = off AS $$
BEGIN
    RETURN (SELECT bool_or(l ~ '^(Index (Only )?Scan using|Bitmap Index Scan on)') FROM jt_cx_plan(q) l);
END
$$;
CREATE FUNCTION jt_cx_count_index(q text) RETURNS bigint
LANGUAGE plpgsql SET enable_seqscan = off SET enable_bitmapscan = off AS $$
DECLARE n bigint;
BEGIN
    EXECUTE q INTO n;
    RETURN n;
END
$$;
CREATE FUNCTION jt_cx_count_seq(q text) RETURNS bigint
LANGUAGE plpgsql SET enable_indexscan = off SET enable_indexonlyscan = off SET enable_bitmapscan = off AS $$
DECLARE n bigint;
BEGIN
    EXECUTE q INTO n;
    RETURN n;
END
$$;
-- t: the table (its column type is the left type), ctype: the type of the two
-- constants, core: the core type of the oracle's constants. Form 1 puts the
-- column on the left, form 2 the constant on the left (the commutated operator).
SELECT t.tbl, t.ctype, t.form,
       jt_cx_index_plan(q.q) AS index_usable,
       jt_cx_count_index(q.q) AS index_rows,
       jt_cx_count_seq(q.q) AS seq_rows,
       jt_cx_count_seq(q.oq) AS core_rows
FROM (VALUES
    ('jt_cx_i_ts', 'jdate', 'date', 1, '1403-02-01', '1403-02-03'),
    ('jt_cx_i_ts', 'jdate', 'date', 2, '1403-02-01', '1403-02-03'),
    ('jt_cx_i_d', 'jtimestamp', 'timestamp', 1, '1403-02-01 00:00:00', '1403-02-03 00:00:00'),
    ('jt_cx_i_d', 'jtimestamp', 'timestamp', 2, '1403-02-01 00:00:00', '1403-02-03 00:00:00'),
    ('jt_cx_i_d', 'jtimestamptz', 'timestamptz', 1, '1403-02-01 00:00:00+00', '1403-02-03 00:00:00+00'),
    ('jt_cx_i_d', 'jtimestamptz', 'timestamptz', 2, '1403-02-01 00:00:00+00', '1403-02-03 00:00:00+00'),
    ('jt_cx_i_tz', 'jdate', 'date', 1, '1403-02-01', '1403-02-03'),
    ('jt_cx_i_tz', 'jdate', 'date', 2, '1403-02-01', '1403-02-03'),
    ('jt_cx_i_tz', 'jtimestamp', 'timestamp', 1, '1403-02-01 00:00:00', '1403-02-03 00:00:00'),
    ('jt_cx_i_tz', 'jtimestamp', 'timestamp', 2, '1403-02-01 00:00:00', '1403-02-03 00:00:00'),
    ('jt_cx_i_ts', 'jtimestamptz', 'timestamptz', 1, '1403-02-01 00:00:00+00', '1403-02-03 00:00:00+00'),
    ('jt_cx_i_ts', 'jtimestamptz', 'timestamptz', 2, '1403-02-01 00:00:00+00', '1403-02-03 00:00:00+00')
  ) t(tbl, ctype, core, form, lo, hi),
  LATERAL (SELECT
      CASE t.form
        WHEN 1 THEN format('SELECT count(*) FROM %s WHERE v >= %L::%s AND v < %L::%s', t.tbl, t.lo, t.ctype, t.hi, t.ctype)
        ELSE format('SELECT count(*) FROM %s WHERE %L::%s <= v AND %L::%s > v', t.tbl, t.lo, t.ctype, t.hi, t.ctype)
      END AS q,
      CASE t.form
        WHEN 1 THEN format('SELECT count(*) FROM %s WHERE c >= %L::%s::%s AND c < %L::%s::%s', t.tbl, t.lo, t.ctype, t.core, t.hi, t.ctype, t.core)
        ELSE format('SELECT count(*) FROM %s WHERE %L::%s::%s <= c AND %L::%s::%s > c', t.tbl, t.lo, t.ctype, t.core, t.hi, t.ctype, t.core)
      END AS oq) q
ORDER BY t.tbl COLLATE "C", t.ctype COLLATE "C", t.form;
    tbl     |    ctype     | form | index_usable | index_rows | seq_rows | core_rows 
------------+--------------+------+--------------+------------+----------+-----------
 jt_cx_i_d  | jtimestamp   |    1 | t            |         20 |       20 |        20
 jt_cx_i_d  | jtimestamp   |    2 | t            |         20 |       20 |        20
 jt_cx_i_d  | jtimestamptz |    1 | t            |         20 |       20 |        20
 jt_cx_i_d  | jtimestamptz |    2 | t            |         20 |       20 |        20
 jt_cx_i_ts | jdate        |    1 | t            |        288 |      288 |       288
 jt_cx_i_ts | jdate        |    2 | t            |        288 |      288 |       288
 jt_cx_i_ts | jtimestamptz |    1 | t            |        288 |      288 |       288
 jt_cx_i_ts | jtimestamptz |    2 | t            |        288 |      288 |       288
 jt_cx_i_tz | jdate        |    1 | t            |        288 |      288 |       288
 jt_cx_i_tz | jdate        |    2 | t            |        288 |      288 |       288
 jt_cx_i_tz | jtimestamp   |    1 | t            |        288 |      288 |       288
 jt_cx_i_tz | jtimestamp   |    2 | t            |        288 |      288 |       288
(12 rows)

-- BETWEEN and equality probes work across the types too, also against the
-- zone of the session
SELECT count(*) AS between_rows,
       count(*) FILTER (WHERE c BETWEEN DATE '2024-04-20' AND DATE '2024-04-21') AS core_rows
FROM jt_cx_i_ts WHERE v BETWEEN '1403-02-01'::jdate AND '1403-02-02'::jdate;
 between_rows | core_rows 
--------------+-----------
          145 |       145
(1 row)

SELECT count(*) AS equality_rows,
       (SELECT count(*) FROM jt_cx_i_d WHERE c = TIMESTAMP '2024-04-20 00:00:00') AS core_rows
FROM jt_cx_i_d WHERE v = '1403-02-01 00:00:00'::jtimestamp;
 equality_rows | core_rows 
---------------+-----------
            10 |        10
(1 row)

SELECT count(*) AS equal_instants, min(id) AS first_id
FROM jt_cx_i_ts WHERE v = '1403-01-01 00:00:00+00'::jtimestamptz;
 equal_instants | first_id 
----------------+----------
              1 |        0
(1 row)

-- the same jtimestamptz is a different jtimestamp row in another zone: the
-- wall clock that is that instant at +03:30 is 03:30 (row 21), the row of
-- 00:00 is the instant written +03:30
SET timezone = '<+03:30>-03:30';
SELECT count(*) AS equal_instants, min(id) AS first_id
FROM jt_cx_i_ts WHERE v = '1403-01-01 00:00:00+00'::jtimestamptz;
 equal_instants | first_id 
----------------+----------
              1 |       21
(1 row)

SELECT count(*) AS equal_instants, min(id) AS first_id
FROM jt_cx_i_ts WHERE v = '1403-01-01 00:00:00+03:30'::jtimestamptz;
 equal_instants | first_id 
----------------+----------
              1 |        0
(1 row)

SET timezone = 'UTC';
-- ---------------------------------------------------------------------
-- what stays the same: a bare literal picks the same-type operator, and no
-- operator mixes a Jalali type with a core type
-- ---------------------------------------------------------------------
CREATE TEMP TABLE jt_cx_r (d jdate, ts jtimestamp, tz jtimestamptz);
CREATE TEMP VIEW jt_cx_rv AS
SELECT d = '1403-01-01' AS a, '1403-01-01' = d AS b, d < '1403-01-01' AS c,
       ts = '1403-01-01 10:00:00' AS e, '1403-01-01 10:00:00' <= ts AS f, ts >= '1403-01-01 10:00:00' AS g,
       tz = '1403-01-01 10:00:00+00' AS h, '1403-01-01 10:00:00+00' > tz AS i, tz <> '1403-01-01 10:00:00+00' AS j,
       d = NULL AS k, ts = NULL AS l, tz = NULL AS m
FROM jt_cx_r;
-- the operators the view uses: all same-type
SELECT s.operator
FROM (SELECT DISTINCT o.oid::regoperator::text AS operator
      FROM pg_rewrite r
      JOIN pg_depend dep ON dep.classid = 'pg_rewrite'::regclass AND dep.objid = r.oid
                        AND dep.refclassid = 'pg_operator'::regclass
      JOIN pg_operator o ON o.oid = dep.refobjid
      WHERE r.ev_class = 'jt_cx_rv'::regclass) s
ORDER BY s.operator COLLATE "C";
           operator            
-------------------------------
 <(jdate,jdate)
 <=(jtimestamp,jtimestamp)
 <>(jtimestamptz,jtimestamptz)
 =(jdate,jdate)
 =(jtimestamp,jtimestamp)
 =(jtimestamptz,jtimestamptz)
 >(jtimestamptz,jtimestamptz)
 >=(jtimestamp,jtimestamp)
(8 rows)

SELECT count(*) FILTER (WHERE o.oprleft <> o.oprright) AS cross_type_operators_used
FROM pg_rewrite r
JOIN pg_depend dep ON dep.classid = 'pg_rewrite'::regclass AND dep.objid = r.oid
                  AND dep.refclassid = 'pg_operator'::regclass
JOIN pg_operator o ON o.oid = dep.refobjid
WHERE r.ev_class = 'jt_cx_rv'::regclass;
 cross_type_operators_used 
---------------------------
                         0
(1 row)

-- none against the core types, in either order (SQLSTATE 42883)
SELECT '1403-01-01'::jdate = date '2024-03-20';
ERROR:  42883
SELECT date '2024-03-20' = '1403-01-01'::jdate;
ERROR:  42883
SELECT '1403-01-01'::jdate < timestamp '2024-03-20 00:00:00';
ERROR:  42883
SELECT timestamp '2024-03-20 00:00:00' < '1403-01-01'::jdate;
ERROR:  42883
SELECT '1403-01-01'::jdate >= timestamptz '2024-03-20 00:00:00+00';
ERROR:  42883
SELECT timestamptz '2024-03-20 00:00:00+00' >= '1403-01-01'::jdate;
ERROR:  42883
SELECT '1403-01-01 00:00:00'::jtimestamp = date '2024-03-20';
ERROR:  42883
SELECT date '2024-03-20' <> '1403-01-01 00:00:00'::jtimestamp;
ERROR:  42883
SELECT '1403-01-01 00:00:00'::jtimestamp > timestamptz '2024-03-20 00:00:00+00';
ERROR:  42883
SELECT timestamptz '2024-03-20 00:00:00+00' <= '1403-01-01 00:00:00'::jtimestamp;
ERROR:  42883
SELECT '1403-01-01 00:00:00+00'::jtimestamptz = date '2024-03-20';
ERROR:  42883
SELECT '1403-01-01 00:00:00+00'::jtimestamptz < timestamp '2024-03-20 00:00:00';
ERROR:  42883
SELECT timestamp '2024-03-20 00:00:00' > '1403-01-01 00:00:00+00'::jtimestamptz;
ERROR:  42883
-- and the core types still compare with each other as before
SELECT date '2024-03-20' = timestamp '2024-03-20 00:00:00' AS core_date_timestamp,
       timestamp '2024-03-20 00:00:00' = timestamptz '2024-03-20 00:00:00+00' AS core_timestamp_timestamptz;
 core_date_timestamp | core_timestamp_timestamptz 
---------------------+----------------------------
 t                   | t
(1 row)

DROP VIEW jt_cx_rv;
DROP FUNCTION jt_cx_join(text, text, int);
DROP FUNCTION jt_cx_index_plan(text);
DROP FUNCTION jt_cx_count_index(text);
DROP FUNCTION jt_cx_count_seq(text);
DROP FUNCTION jt_cx_matrix();
DROP FUNCTION jt_cx_plan(text);
