-- ---------------------------------------------------------------------
-- 6. Negative controls: each sweep above can fail. A deliberately wrong oracle must
--    report mismatches (true below), so a zero in a sweep means agreement and not a
--    comparison that cannot differ. The first three use the sweep functions
--    themselves with a wrong oracle (the hours, the range edges, the bins), the rest
--    are the wrong answers a plausible bug would give: Gregorian months, a day of
--    24 hours, a calendar that does not clamp the month end, a series without drift.
-- ---------------------------------------------------------------------
-- (1) the sweep of every hour with every oracle instant one hour off: every one of the
-- 8784 hours must be reported by each of the four counters, in two zones and years
SELECT bool_and(plus_day = hours AND minus_day = hours AND plus_month = hours AND minus_month = hours)
         AS control_hours_skewed_oracle_differs
FROM (SELECT * FROM pg_temp.sweep_hours('Europe/Paris', 'sw_h2024', interval '1 hour')
      UNION ALL SELECT * FROM pg_temp.sweep_hours('Asia/Tehran', 'sw_h2020', interval '1 hour')) x;
 control_hours_skewed_oracle_differs 
-------------------------------------
 t
(1 row)

-- (2) range edges: the oracle with its safe range one hour too wide, or too narrow at
-- +15:59, must disagree
SELECT bool_or(mismatches > 0) AS control_edge_margin_differs
FROM pg_temp.sweep_edges('UTC', interval '1 hour');
 control_edge_margin_differs 
-----------------------------
 t
(1 row)

SELECT bool_or(mismatches > 0) AS control_edge_margin_differs_at_plus_1559
FROM pg_temp.sweep_edges('<+15:59>-15:59', interval '-1 hour');
 control_edge_margin_differs_at_plus_1559 
------------------------------------------
 t
(1 row)

-- (3) jdate_bin: a formula with the origin one minute late must disagree
SELECT bool_or(vs_formula > 0) AS control_bin_origin_differs FROM pg_temp.sweep_bin('sw_h2024', 60);
 control_bin_origin_differs 
----------------------------
 t
(1 row)

-- (4) core's Gregorian month in place of the Jalali month: every hour of 2024 in Paris
SET TimeZone = 'Europe/Paris';
SELECT count(*) FILTER (WHERE (t::jtimestamptz + interval '1 month')::timestamptz
                              IS DISTINCT FROM t + interval '1 month') > 0 AS control_gregorian_month_differs
FROM sw_h2024;
 control_gregorian_month_differs 
---------------------------------
 t
(1 row)

-- (5) the day step counted as 24 hours of elapsed time instead of a wall clock day
SELECT count(*) FILTER (WHERE (t::jtimestamptz + interval '1 day')::timestamptz
                              IS DISTINCT FROM t + interval '24 hours') > 0 AS control_day_is_not_24_hours
FROM sw_h2024;
 control_day_is_not_24_hours 
-----------------------------
 t
(1 row)

-- (6) the oracle of another zone: the session is Paris, the oracle Kathmandu
SELECT count(*) FILTER (WHERE (t::jtimestamptz + interval '1 day')::timestamptz
                              IS DISTINCT FROM ((t AT TIME ZONE 'Asia/Kathmandu') + interval '1 day')
                                               AT TIME ZONE 'Asia/Kathmandu') > 0 AS control_wrong_zone_differs
FROM sw_h2024;
 control_wrong_zone_differs 
----------------------------
 t
(1 row)

SET TimeZone = 'UTC';
-- (7) month ends: a day that does not exist in the target month rolls into the next
-- month (the first of the month plus day - 1 days), as a calendar that does not
-- clamp would do; the clamp is what the type does
SELECT count(*) FILTER (WHERE (s.jd + make_interval(months => s.n))::jdate
                              IS DISTINCT FROM (pg_temp.ymd(jdate_part('year', s.want)::int,
                                                            jdate_part('month', s.want)::int, 1)::jdate
                                                + (jdate_part('day', s.jd)::int - 1))) > 0 AS control_rolled_month_end_differs
FROM sw_steps s WHERE s.unit = 'month' AND s.want IS NOT NULL;
 control_rolled_month_end_differs 
----------------------------------
 t
(1 row)

-- (8) series: element n + 1 as the start plus n steps (no drift) differs from the series
SELECT count(*) FILTER (WHERE
           ARRAY(SELECT g::timestamp FROM jgenerate_series(st::jtimestamp, '1405-01-01'::jtimestamp, interval '1 month') g)
           IS DISTINCT FROM
           ARRAY(SELECT (st::jtimestamp + i * interval '1 month')::timestamp FROM generate_series(0, 40) i
                 WHERE st::jtimestamp + i * interval '1 month' <= '1405-01-01'::jtimestamp)) > 0 AS control_no_drift_differs
FROM (VALUES ('1403-01-31 00:00'), ('1403-06-31 00:00')) v(st);
 control_no_drift_differs 
--------------------------
 t
(1 row)

-- ---------------------------------------------------------------------
-- 7. The volatility catalog of every function Stage J3 added, against the report
--    (the feasibility report and the task notes): arithmetic that reads the session
--    zone is STABLE, everything else is IMMUTABLE, as the core function it mirrors
--    (timestamptz_pl_interval, date_pl_interval, generate_series, date_bin, timezone,
--    overlaps); all are PARALLEL SAFE, and STRICT except OVERLAPS (core's is not).
--    A function a task added and this list does not know would make the count of
--    members of the extension with these names differ from the list.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE sw_vol (sig text, vol "char", strict boolean, task text);
INSERT INTO sw_vol VALUES
  -- J3.A1: jtimestamp +/- interval, differences
  ('jtimestamp_pl_interval(jtimestamp,interval)', 'i', true, 'A1'),
  ('interval_pl_jtimestamp(interval,jtimestamp)', 'i', true, 'A1'),
  ('jtimestamp_mi_interval(jtimestamp,interval)', 'i', true, 'A1'),
  ('jtimestamp_mi(jtimestamp,jtimestamp)', 'i', true, 'A1'),
  ('jdate_mi_jtimestamp(jdate,jtimestamp)', 'i', true, 'A1'),
  ('jtimestamp_mi_jdate(jtimestamp,jdate)', 'i', true, 'A1'),
  -- J3.A2: jtimestamptz (session zone: STABLE, the difference of two instants IMMUTABLE),
  -- jdate + interval and the time operators
  ('jtimestamptz_pl_interval(jtimestamptz,interval)', 's', true, 'A2'),
  ('interval_pl_jtimestamptz(interval,jtimestamptz)', 's', true, 'A2'),
  ('jtimestamptz_mi_interval(jtimestamptz,interval)', 's', true, 'A2'),
  ('jtimestamptz_mi(jtimestamptz,jtimestamptz)', 'i', true, 'A2'),
  ('jdate_mi_jtimestamptz(jdate,jtimestamptz)', 's', true, 'A2'),
  ('jtimestamptz_mi_jdate(jtimestamptz,jdate)', 's', true, 'A2'),
  ('jdate_pl_interval(jdate,interval)', 'i', true, 'A2'),
  ('interval_pl_jdate(interval,jdate)', 'i', true, 'A2'),
  ('jdate_mi_interval(jdate,interval)', 'i', true, 'A2'),
  ('jdate_pl_time(jdate,time without time zone)', 'i', true, 'A2'),
  ('time_pl_jdate(time without time zone,jdate)', 'i', true, 'A2'),
  ('jdate_pl_timetz(jdate,time with time zone)', 'i', true, 'A2'),
  ('timetz_pl_jdate(time with time zone,jdate)', 'i', true, 'A2'),
  -- J3.A3: jgenerate_series (the jtimestamptz form that reads the session zone is STABLE,
  -- the one with a zone argument IMMUTABLE)
  ('jgenerate_series(jtimestamp,jtimestamp,interval)', 'i', true, 'A3'),
  ('jgenerate_series(jtimestamptz,jtimestamptz,interval)', 's', true, 'A3'),
  ('jgenerate_series(jtimestamptz,jtimestamptz,interval,text)', 'i', true, 'A3'),
  ('jgenerate_series(jdate,jdate,interval)', 'i', true, 'A3'),
  ('jgenerate_series(jdate,jdate,integer)', 'i', true, 'A3'),
  -- J3.B1: jdate_bin, AT TIME ZONE, OVERLAPS
  ('jdate_bin(interval,jtimestamp,jtimestamp)', 'i', true, 'B1'),
  ('jdate_bin(interval,jtimestamptz,jtimestamptz)', 'i', true, 'B1'),
  ('pg_catalog.timezone(text,jtimestamp)', 'i', true, 'B1'),
  ('pg_catalog.timezone(interval,jtimestamp)', 'i', true, 'B1'),
  ('pg_catalog.timezone(text,jtimestamptz)', 'i', true, 'B1'),
  ('pg_catalog.timezone(interval,jtimestamptz)', 'i', true, 'B1'),
  ('pg_catalog.overlaps(jtimestamp,jtimestamp,jtimestamp,jtimestamp)', 'i', false, 'B1'),
  ('pg_catalog.overlaps(jtimestamptz,jtimestamptz,jtimestamptz,jtimestamptz)', 'i', false, 'B1');
SELECT v.task, v.sig, v.vol AS expected, p.provolatile AS actual,
       p.provolatile = v.vol AS volatility_ok, p.proisstrict = v.strict AS strict_ok,
       p.proparallel = 's' AS parallel_safe
FROM sw_vol v LEFT JOIN pg_proc p ON p.oid = to_regprocedure(v.sig)
ORDER BY v.task, v.sig COLLATE "C";
