-- jtimestamp (no zone): the range is the whole of the first and the last day
CREATE TEMP TABLE sw_egrid_ts AS
SELECT g.edge,
       CASE g.edge WHEN 'lower' THEN b.d0::timestamp + (g.t - b.lo)
                   ELSE (b.d1 + 1)::timestamp + (g.t - b.hi) END AS t
FROM sw_egrid g, sw_bounds b;
CREATE FUNCTION pg_temp.try_ts(t jtimestamp, iv interval, sgn int, OUT r timestamp, OUT st text)
LANGUAGE plpgsql AS $f$
BEGIN
    IF sgn > 0 THEN r := (t + iv)::timestamp; ELSE r := (t - iv)::timestamp; END IF;
EXCEPTION WHEN OTHERS THEN
    r := NULL;
    st := SQLSTATE;
END
$f$;
WITH j AS (
    SELECT g.edge, g.t AS loc, g.t::jtimestamp AS jt, o.*
    FROM sw_egrid_ts g CROSS JOIN sw_ops o
), w AS (
    SELECT j.*, m.d IS NULL AND j.mo <> 0 AS nomap,
           CASE WHEN j.mo = 0 THEN j.loc::date ELSE m.nd END AS nd
    FROM j LEFT JOIN sw_edmap m ON m.d = j.loc::date AND m.n = j.mo
), x AS (
    SELECT w.edge, w.nomap, ((w.nd + w.loc::time) + w.dy * interval '1 day') + w.tm AS want, a.r, a.st
    FROM w CROSS JOIN LATERAL pg_temp.try_ts(w.jt, w.iv, w.sgn) a
), y AS (
    SELECT x.*, x.want IS NOT NULL AND x.want >= b.d0::timestamp AND x.want < (b.d1 + 1)::timestamp AS inside
    FROM x, sw_bounds b
)
SELECT 'jtimestamp' AS type, y.edge, count(*) AS cases, count(*) FILTER (WHERE y.inside) AS inside,
       count(*) FILTER (WHERE NOT y.inside) AS outside, count(*) FILTER (WHERE y.nomap) AS unmapped,
       count(*) FILTER (WHERE CASE WHEN y.inside THEN y.st IS NOT NULL OR y.r <> y.want
                                   ELSE y.st IS DISTINCT FROM '22008' END) AS mismatches
FROM y GROUP BY y.edge ORDER BY y.edge;
    type    | edge  | cases | inside | outside | unmapped | mismatches 
------------+-------+-------+--------+---------+----------+------------
 jtimestamp | lower |  2472 |   1914 |     558 |        0 |          0
 jtimestamp | upper |  2472 |   1922 |     550 |        0 |          0
(2 rows)

-- ---------------------------------------------------------------------
-- 4. Series over the same days. jgenerate_series against core's generate_series
--    wherever the step has no month part (the same instants, so the same wall
--    clock across a daylight saving change), and against the oracle where it has:
--    element n + 1 is element n moved by the oracle table (the clamp sticks), back
--    to an instant by core for jtimestamptz.
-- ---------------------------------------------------------------------
-- the oracle series, jtimestamp: from st while the element has not passed fin
CREATE FUNCTION pg_temp.oseries_ts(st timestamp, fin timestamp, step int) RETURNS timestamp[]
LANGUAGE plpgsql AS $f$
DECLARE
    r timestamp[] := '{}';
    cur timestamp := st;
    nd date;
BEGIN
    WHILE (step > 0 AND cur <= fin) OR (step < 0 AND cur >= fin) LOOP
        r := r || cur;
        SELECT m.nd INTO nd FROM sw_dmap m WHERE m.d = cur::date AND m.n = step;
        IF nd IS NULL THEN RAISE EXCEPTION 'no oracle row'; END IF;
        cur := nd + cur::time;
        IF cardinality(r) > 1000 THEN RAISE EXCEPTION 'runaway'; END IF;
    END LOOP;
    RETURN r;
END
$f$;
-- ... and jtimestamptz in zone z: the step on the wall clock, back through core
CREATE FUNCTION pg_temp.oseries_tz(st timestamptz, fin timestamptz, step int, z text) RETURNS timestamptz[]
LANGUAGE plpgsql AS $f$
DECLARE
    r timestamptz[] := '{}';
    cur timestamptz := st;
    loc timestamp;
    nd date;
BEGIN
    WHILE (step > 0 AND cur <= fin) OR (step < 0 AND cur >= fin) LOOP
        r := r || cur;
        loc := cur AT TIME ZONE z;
        SELECT m.nd INTO nd FROM sw_dmap m WHERE m.d = loc::date AND m.n = step;
        IF nd IS NULL THEN RAISE EXCEPTION 'no oracle row'; END IF;
        cur := (nd + loc::time) AT TIME ZONE z;
        IF cardinality(r) > 1000 THEN RAISE EXCEPTION 'runaway'; END IF;
    END LOOP;
    RETURN r;
END
$f$;
-- 4a. jtimestamptz in zone z, starting every day of the year at wall time tm: the
-- series of one month and of one year, forwards and backwards, against the oracle;
-- then the series of one day and of seven days starting at every hour of the first
-- day, and of one hour from the first hour, to the end of the year, against core's
-- generate_series; and the form with the zone argument against the form that reads
-- the session zone
CREATE FUNCTION pg_temp.sweep_series_tz(z text, y0 date, tm time)
RETURNS TABLE (check_name text, series bigint, elements bigint, mismatches bigint)
LANGUAGE plpgsql AS $f$
DECLARE
    t0 timestamptz := y0::timestamp AT TIME ZONE 'UTC';
    fin timestamptz := (y0 + 365 + 0)::timestamp AT TIME ZONE 'UTC' + interval '23 hours';
BEGIN
    PERFORM set_config('TimeZone', z, false);
    RETURN QUERY
    SELECT v.name, count(*), sum(cardinality(q.b)), count(*) FILTER (WHERE q.a IS DISTINCT FROM q.b)
    FROM (VALUES ('month step', 1, 470), ('minus one month', -1, -400),
                 ('year step', 12, 800), ('minus one year', -12, -800)) v(name, step, span),
         LATERAL (
        SELECT ARRAY(SELECT g::timestamptz
                     FROM jgenerate_series(s.st::jtimestamptz,
                                           (((y0 + v.span)::timestamp) AT TIME ZONE z)::jtimestamptz,
                                           make_interval(months => v.step)) g) AS a,
               pg_temp.oseries_tz(s.st, ((y0 + v.span)::timestamp) AT TIME ZONE z, v.step, z) AS b
        FROM (SELECT ((y0 + i) + tm) AT TIME ZONE z AS st FROM generate_series(0, 365) i) s) q
    GROUP BY v.name ORDER BY v.name COLLATE "C";
    RETURN QUERY
    SELECT 'day, week and hour steps'::text, count(*), sum(cardinality(q.b)),
           count(*) FILTER (WHERE q.a IS DISTINCT FROM q.b OR q.c IS DISTINCT FROM q.b)
    FROM (SELECT t0 + h * interval '1 hour' AS st, step
          FROM generate_series(0, 23) h, (VALUES (interval '1 day'), (interval '7 days')) v(step)
          UNION ALL SELECT t0, interval '1 hour') s,
         LATERAL (
        SELECT ARRAY(SELECT g::timestamptz FROM jgenerate_series(s.st::jtimestamptz, fin::jtimestamptz, s.step) g) AS a,
               ARRAY(SELECT g FROM generate_series(s.st, fin, s.step) g) AS b,
               ARRAY(SELECT g::timestamptz FROM jgenerate_series(s.st::jtimestamptz, fin::jtimestamptz, s.step, z) g) AS c) q;
    PERFORM set_config('TimeZone', 'UTC', false);
END
$f$;
SELECT 'Europe/Paris 2024' AS grid, * FROM pg_temp.sweep_series_tz('Europe/Paris', date '2024-01-01', time '02:30');
       grid        |        check_name        | series | elements | mismatches 
-------------------+--------------------------+--------+----------+------------
 Europe/Paris 2024 | minus one month          |    366 |     7207 |          0
 Europe/Paris 2024 | minus one year           |    366 |     1169 |          0
 Europe/Paris 2024 | month step               |    366 |     3648 |          0
 Europe/Paris 2024 | year step                |    366 |      801 |          0
 Europe/Paris 2024 | day, week and hour steps |     49 |    18840 |          0
(5 rows)

