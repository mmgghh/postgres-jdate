SELECT count(*) AS listed,
       count(p.oid) AS found,
       count(*) FILTER (WHERE p.provolatile = v.vol AND p.proisstrict = v.strict AND p.proparallel = 's') AS all_ok,
       (SELECT count(*) FROM pg_proc q JOIN pg_depend d ON d.classid = 'pg_proc'::regclass AND d.objid = q.oid
                                                      AND d.deptype = 'e'
                                                      AND d.refobjid = (SELECT oid FROM pg_extension WHERE extname = 'jdate')
        WHERE q.proname IN (SELECT split_part(split_part(sig, '(', 1), '.', 2 - (sig NOT LIKE '%.%')::int)
                            FROM sw_vol)) AS extension_functions_with_these_names
FROM sw_vol v LEFT JOIN pg_proc p ON p.oid = to_regprocedure(v.sig);
 listed | found | all_ok | extension_functions_with_these_names 
