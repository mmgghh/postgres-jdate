(1 row)

SELECT 'Asia/Kathmandu 2020' AS grid, * FROM pg_temp.sweep_hours('Asia/Kathmandu', 'sw_h2020');
        grid         | hours | plus_day | minus_day | plus_month | minus_month | gap_day | overlap_day | gap_month | overlap_month 
---------------------+-------+----------+-----------+------------+-------------+---------+-------------+-----------+---------------
 Asia/Kathmandu 2020 |  8784 |        0 |         0 |          0 |           0 | f       | f           | f         | f
(1 row)

-- the same hours as jtimestamp wall clocks (no zone, so no gaps), in UTC, and the
-- days of both years as jdate with a one month, one day and one year step
CREATE FUNCTION pg_temp.sweep_hours_ts(grid regclass)
RETURNS TABLE (hours bigint, plus_day bigint, minus_day bigint, plus_month bigint,
               minus_month bigint, plus_year bigint, minus_year bigint)
LANGUAGE plpgsql AS $f$
BEGIN
    RETURN QUERY EXECUTE format($q$
    WITH j AS (
        SELECT w.loc, w.loc::jtimestamp AS jt, w.loc::time AS tod,
               p.nd AS nplus, m.nd AS nminus, py.nd AS nyplus, my.nd AS nyminus
        FROM (SELECT g.t AT TIME ZONE 'UTC' AS loc FROM %s g) w
        JOIN sw_dmap p ON p.d = w.loc::date AND p.n = 1
        JOIN sw_dmap m ON m.d = w.loc::date AND m.n = -1
        JOIN sw_dmap py ON py.d = w.loc::date AND py.n = 12
        JOIN sw_dmap my ON my.d = w.loc::date AND my.n = -12
    )
    SELECT count(*),
           count(*) FILTER (WHERE (j.jt + interval '1 day')::timestamp IS DISTINCT FROM j.loc + interval '1 day'),
           count(*) FILTER (WHERE (j.jt - interval '1 day')::timestamp IS DISTINCT FROM j.loc - interval '1 day'),
           count(*) FILTER (WHERE (j.jt + interval '1 month')::timestamp IS DISTINCT FROM j.nplus + j.tod),
           count(*) FILTER (WHERE (j.jt - interval '1 month')::timestamp IS DISTINCT FROM j.nminus + j.tod),
           count(*) FILTER (WHERE (j.jt + interval '1 year')::timestamp IS DISTINCT FROM j.nyplus + j.tod),
           count(*) FILTER (WHERE (j.jt - interval '1 year')::timestamp IS DISTINCT FROM j.nyminus + j.tod)
    FROM j
    $q$, grid);
END
$f$;
SELECT 'jtimestamp 2024' AS grid, * FROM pg_temp.sweep_hours_ts('sw_h2024');
      grid       | hours | plus_day | minus_day | plus_month | minus_month | plus_year | minus_year 
-----------------+-------+----------+-----------+------------+-------------+-----------+------------
 jtimestamp 2024 |  8784 |        0 |         0 |          0 |           0 |         0 |          0
(1 row)

SELECT 'jtimestamp 2020' AS grid, * FROM pg_temp.sweep_hours_ts('sw_h2020');
      grid       | hours | plus_day | minus_day | plus_month | minus_month | plus_year | minus_year 
-----------------+-------+----------+-----------+------------+-------------+-----------+------------
 jtimestamp 2020 |  8784 |        0 |         0 |          0 |           0 |         0 |          0
(1 row)

-- jdate + interval returns the jtimestamp of the midnight; every local day
SELECT count(DISTINCT d) AS days,
       count(*) FILTER (WHERE (d::jdate + interval '1 day')::timestamp IS DISTINCT FROM (d + 1)::timestamp
                           OR (d::jdate - interval '1 day')::timestamp IS DISTINCT FROM (d - 1)::timestamp) AS day_mismatches,
       count(*) FILTER (WHERE n IN (1, -1)
                          AND (d::jdate + make_interval(months => n))::timestamp IS DISTINCT FROM nd::timestamp) AS plus_month_mismatches,
       count(*) FILTER (WHERE n IN (1, -1)
                          AND (d::jdate - make_interval(months => -n))::timestamp IS DISTINCT FROM nd::timestamp) AS minus_month_mismatches,
       count(*) FILTER (WHERE n IN (12, -12)
                          AND (d::jdate + make_interval(years => n / 12))::timestamp IS DISTINCT FROM nd::timestamp) AS year_mismatches
FROM sw_dmap
WHERE d BETWEEN date '2023-12-31' AND date '2025-01-01' OR d BETWEEN date '2019-12-31' AND date '2021-01-01';
 days | day_mismatches | plus_month_mismatches | minus_month_mismatches | year_mismatches 
------+----------------+-----------------------+------------------------+-----------------
  736 |              0 |                     0 |                      0 |               0
(1 row)

-- ---------------------------------------------------------------------
-- 2. Every month end of the leap years 1399, 1403, 1408, 1412 and of the common
--    years between (1399 to 1412), plus the 30th of the months that have 31 days
--    (the other day that is clamped): + n months for n from -48 to 48 and
--    + n years for n from -16 to 16, with the - operator on the negated step, for
--    jtimestamp, jdate and jtimestamptz in UTC and in Asia/Tehran, each against the
--    oracle.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE sw_ends AS
SELECT y, m, d, pg_temp.ymd(y, m, d)::jdate AS jd
FROM generate_series(1399, 1412) y, generate_series(1, 12) m,
     LATERAL (SELECT pg_temp.mlen(y, m) AS d
              UNION SELECT 30 WHERE pg_temp.mlen(y, m) = 31) dd(d);
SELECT count(*) AS start_days,
       count(*) FILTER (WHERE d = pg_temp.mlen(y, m)) AS month_ends,
       count(*) FILTER (WHERE y IN (1399, 1403, 1408, 1412) AND m = 12 AND d = 30) AS leap_esfand_30
FROM sw_ends;
 start_days | month_ends | leap_esfand_30 
------------+------------+----------------
        252 |        168 |              4
(1 row)

CREATE TEMP TABLE sw_steps AS
SELECT s.jd, k.unit, k.n,
       pg_temp.oadd(s.jd, CASE k.unit WHEN 'month' THEN k.n ELSE 12 * k.n END) AS want
FROM sw_ends s,
     (SELECT 'month' AS unit, n FROM generate_series(-48, 48) n
      UNION ALL SELECT 'year', n FROM generate_series(-16, 16) n) k;
ANALYZE sw_steps;
SELECT unit, count(*) AS cases, count(*) FILTER (WHERE want IS NULL) AS outside_range,
       count(*) FILTER (WHERE want IS NOT NULL
                          AND jdate_part('day', want) < jdate_part('day', jd)) AS clamped
FROM sw_steps GROUP BY unit ORDER BY unit;
 unit  | cases | outside_range | clamped 
-------+-------+---------------+---------
 month | 24444 |             0 |    5004
 year  |  8316 |             0 |     100
(2 rows)

-- jtimestamp: start at 13:45:30.123456, + the step and - the negated step
SELECT unit, count(*) AS cases,
       count(*) FILTER (WHERE
           ((jd::text || ' 13:45:30.123456')::jtimestamp
             + CASE unit WHEN 'month' THEN make_interval(months => n) ELSE make_interval(years => n) END)::timestamp
           IS DISTINCT FROM want::date + time '13:45:30.123456') AS plus_mismatches,
       count(*) FILTER (WHERE
           ((jd::text || ' 13:45:30.123456')::jtimestamp
             - CASE unit WHEN 'month' THEN make_interval(months => -n) ELSE make_interval(years => -n) END)::timestamp
           IS DISTINCT FROM want::date + time '13:45:30.123456') AS minus_mismatches
FROM sw_steps GROUP BY unit ORDER BY unit;
 unit  | cases | plus_mismatches | minus_mismatches 
-------+-------+-----------------+------------------
 month | 24444 |               0 |                0
 year  |  8316 |               0 |                0
(2 rows)

-- jdate: the result is the jtimestamp of the midnight
SELECT unit, count(*) AS cases,
       count(*) FILTER (WHERE
           (jd + CASE unit WHEN 'month' THEN make_interval(months => n) ELSE make_interval(years => n) END)::timestamp
           IS DISTINCT FROM want::date::timestamp) AS plus_mismatches,
       count(*) FILTER (WHERE
           (jd - CASE unit WHEN 'month' THEN make_interval(months => -n) ELSE make_interval(years => -n) END)::timestamp
           IS DISTINCT FROM want::date::timestamp) AS minus_mismatches
FROM sw_steps GROUP BY unit ORDER BY unit;
 unit  | cases | plus_mismatches | minus_mismatches 
-------+-------+-----------------+------------------
 month | 24444 |               0 |                0
 year  |  8316 |               0 |                0
(2 rows)

-- jtimestamptz at 13:45:30.123456 local time of the zone
CREATE FUNCTION pg_temp.sweep_ends_tz(z text)
RETURNS TABLE (unit text, cases bigint, plus_mismatches bigint, minus_mismatches bigint)
LANGUAGE plpgsql AS $f$
BEGIN
    PERFORM set_config('TimeZone', z, false);
    RETURN QUERY
    WITH j AS (
        SELECT s.unit, s.n, s.want,
               ((s.jd::date + time '13:45:30.123456') AT TIME ZONE z)::jtimestamptz AS st
        FROM sw_steps s
    )
    SELECT j.unit, count(*),
           count(*) FILTER (WHERE (j.st + CASE j.unit WHEN 'month' THEN make_interval(months => j.n)
                                                      ELSE make_interval(years => j.n) END)::timestamptz
                                  IS DISTINCT FROM ((j.want::date + time '13:45:30.123456') AT TIME ZONE z)),
           count(*) FILTER (WHERE (j.st - CASE j.unit WHEN 'month' THEN make_interval(months => -j.n)
                                                      ELSE make_interval(years => -j.n) END)::timestamptz
                                  IS DISTINCT FROM ((j.want::date + time '13:45:30.123456') AT TIME ZONE z))
    FROM j GROUP BY j.unit ORDER BY j.unit;
    PERFORM set_config('TimeZone', 'UTC', false);
END
$f$;
SELECT 'UTC' AS zone, * FROM pg_temp.sweep_ends_tz('UTC');
 zone | unit  | cases | plus_mismatches | minus_mismatches 
------+-------+-------+-----------------+------------------
 UTC  | month | 24444 |               0 |                0
 UTC  | year  |  8316 |               0 |                0
(2 rows)

SELECT 'Asia/Tehran' AS zone, * FROM pg_temp.sweep_ends_tz('Asia/Tehran');
    zone     | unit  | cases | plus_mismatches | minus_mismatches 
-------------+-------+-------+-----------------+------------------
 Asia/Tehran | month | 24444 |               0 |                0
 Asia/Tehran | year  |  8316 |               0 |                0
(2 rows)

-- ---------------------------------------------------------------------
-- 3. The range edges. jtimestamptz has a safe range, from 16 hours after the start
--    of the first day (-0061-01-01) to 16 hours before the end of the last
--    (3177-12-29), so every stored instant prints in a zone up to +/-15:59. The
--    bounds come from the real jdate cast and core's arithmetic. Instants every
--    half hour for the first two days from each edge, every hour to the fourth
--    day, every six hours to the 45th day (the month steps change their answer at
--    about a month), the last valid instant included: each plus and minus one day,
--    one hour, one month, one month and one day, in the zones UTC, +14, -11,
--    +15:59 and -15:59 (POSIX names: fixed offsets, no tzdata in the answer).
--    The oracle says what the result would be in core's wide range; the answer is
--    an error (22008) when that is outside the safe range or the month step leaves
--    the Jalali years, else the same instant.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE sw_bounds AS
SELECT ('-0061-01-01'::jdate)::date AS d0, ('3177-12-29'::jdate)::date AS d1,
       (('-0061-01-01'::jdate)::date + time '16:00') AT TIME ZONE 'UTC' AS lo,
       (('3177-12-29'::jdate)::date + time '08:00') AT TIME ZONE 'UTC' AS hi;
CREATE TEMP TABLE sw_egrid AS
SELECT 'lower'::text AS edge, b.lo + k * interval '30 minutes' AS t
  FROM sw_bounds b, generate_series(0, 95) k
UNION ALL SELECT 'lower', b.lo + k * interval '1 hour' FROM sw_bounds b, generate_series(48, 96) k
UNION ALL SELECT 'lower', b.lo + k * interval '6 hours' FROM sw_bounds b, generate_series(17, 180) k
UNION ALL SELECT 'upper', b.hi - interval '1 microsecond' FROM sw_bounds b
UNION ALL SELECT 'upper', b.hi - k * interval '30 minutes' FROM sw_bounds b, generate_series(1, 96) k
UNION ALL SELECT 'upper', b.hi - k * interval '1 hour' FROM sw_bounds b, generate_series(49, 96) k
UNION ALL SELECT 'upper', b.hi - k * interval '6 hours' FROM sw_bounds b, generate_series(17, 180) k;
SELECT edge, count(*) AS instants FROM sw_egrid GROUP BY edge ORDER BY edge;
 edge  | instants 
-------+----------
 lower |      309
 upper |      309
(2 rows)

-- the oracle table of month steps for the local dates near the edges
CREATE TEMP TABLE sw_edmap AS
SELECT d::date AS d, n, pg_temp.oadd(d::date::jdate, n)::date AS nd
FROM (SELECT g FROM sw_bounds b, generate_series(b.d0, b.d0 + 50, interval '1 day') g
      UNION ALL
      SELECT g FROM sw_bounds b, generate_series(b.d1 - 50, b.d1, interval '1 day') g) days(d),
     (VALUES (1), (-1)) v(n);
CREATE UNIQUE INDEX ON sw_edmap (d, n);
ANALYZE sw_edmap;
-- the steps: label, interval, sign of the operator, month step, day step (both
-- signed as applied), time step
CREATE TEMP TABLE sw_ops (label text, iv interval, sgn int, mo int, dy int, tm interval);
INSERT INTO sw_ops VALUES
  ('+1 day', '1 day', 1, 0, 1, '0'), ('-1 day', '1 day', -1, 0, -1, '0'),
  ('+1 hour', '1 hour', 1, 0, 0, '1 hour'), ('-1 hour', '1 hour', -1, 0, 0, '-1 hour'),
  ('+1 month', '1 month', 1, 1, 0, '0'), ('-1 month', '1 month', -1, -1, 0, '0'),
  ('+1 month 1 day', '1 month 1 day', 1, 1, 1, '0'), ('-1 month 1 day', '1 month 1 day', -1, -1, -1, '0');
-- the instant or the SQLSTATE of t + iv or t - iv
CREATE FUNCTION pg_temp.try_tz(t jtimestamptz, iv interval, sgn int, OUT r timestamptz, OUT st text)
LANGUAGE plpgsql AS $f$
BEGIN
    IF sgn > 0 THEN r := (t + iv)::timestamptz; ELSE r := (t - iv)::timestamptz; END IF;
EXCEPTION WHEN OTHERS THEN
    r := NULL;
    st := SQLSTATE;
END
$f$;
-- adj shifts both bounds of the oracle (zero in the sweeps, not zero in the control)
CREATE FUNCTION pg_temp.sweep_edges(z text, adj interval DEFAULT '0')
RETURNS TABLE (edge text, cases bigint, inside bigint, outside bigint, unmapped bigint, mismatches bigint)
LANGUAGE plpgsql AS $f$
BEGIN
    PERFORM set_config('TimeZone', z, false);
    RETURN QUERY
    WITH j AS (
        SELECT g.edge, g.t::jtimestamptz AS jt, g.t AS t, o.*,
               g.t AT TIME ZONE z AS loc
        FROM sw_egrid g CROSS JOIN sw_ops o
    ), w AS (
        SELECT j.*, m.d IS NULL AND j.mo <> 0 AS nomap,
               CASE WHEN j.mo = 0 THEN j.loc::date ELSE m.nd END AS nd
        FROM j LEFT JOIN sw_edmap m ON m.d = j.loc::date AND m.n = j.mo
    ), x AS (
        SELECT w.edge, w.nomap,
               (((w.nd + w.loc::time) + w.dy * interval '1 day') AT TIME ZONE z) + w.tm AS want, a.r, a.st
        FROM w CROSS JOIN LATERAL pg_temp.try_tz(w.jt, w.iv, w.sgn) a
    ), y AS (
        SELECT x.*, x.want IS NOT NULL AND x.want >= b.lo + adj AND x.want < b.hi + adj AS inside
        FROM x, sw_bounds b
    )
    SELECT y.edge, count(*), count(*) FILTER (WHERE y.inside),
           count(*) FILTER (WHERE NOT y.inside), count(*) FILTER (WHERE y.nomap),
           count(*) FILTER (WHERE CASE WHEN y.inside THEN y.st IS NOT NULL OR y.r <> y.want
                                       ELSE y.st IS DISTINCT FROM '22008' END)
    FROM y GROUP BY y.edge ORDER BY y.edge;
    PERFORM set_config('TimeZone', 'UTC', false);
END
$f$;
SELECT 'UTC' AS zone, * FROM pg_temp.sweep_edges('UTC');
 zone | edge  | cases | inside | outside | unmapped | mismatches 
------+-------+-------+--------+---------+----------+------------
 UTC  | lower |  2472 |   1914 |     558 |        0 |          0
 UTC  | upper |  2472 |   1919 |     553 |        0 |          0
(2 rows)

