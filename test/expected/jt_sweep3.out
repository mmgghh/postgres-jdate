(1 row)

SELECT 'Europe/Paris 2020' AS grid, * FROM pg_temp.sweep_hours('Europe/Paris', 'sw_h2020');
       grid        | hours | plus_day | minus_day | plus_month | minus_month | gap_day | overlap_day | gap_month | overlap_month 
-------------------+-------+----------+-----------+------------+-------------+---------+-------------+-----------+---------------
