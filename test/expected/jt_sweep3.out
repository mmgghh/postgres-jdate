-- 4b. jtimestamp and jdate series, starting every day of 2024 at 13:45:30.123456 (jdate:
-- at midnight)
WITH s AS (
    SELECT d::date AS d FROM generate_series(date '2024-01-01', date '2024-12-31', interval '1 day') d
), q AS (
    SELECT st.step, st.fin,
           ARRAY(SELECT g::timestamp FROM jgenerate_series((s.d + time '13:45:30.123456')::jtimestamp,
                  st.fin::jtimestamp, make_interval(months => st.step)) g) AS a,
           pg_temp.oseries_ts(s.d + time '13:45:30.123456', st.fin, st.step) AS b,
           ARRAY(SELECT g::timestamp FROM jgenerate_series(s.d::jdate, st.fin::date::jdate,
                  make_interval(months => st.step)) g) AS c,
           pg_temp.oseries_ts(s.d::timestamp, st.fin::date::timestamp, st.step) AS e
    FROM s, (VALUES (1, timestamp '2025-04-15 00:00'), (-1, timestamp '2022-12-01 00:00'),
                    (12, timestamp '2027-01-01 00:00'), (-12, timestamp '2021-01-01 00:00')) st(step, fin)
)
SELECT step AS months_step, count(*) AS series, sum(cardinality(b)) AS elements,
       count(*) FILTER (WHERE a IS DISTINCT FROM b) AS jtimestamp_mismatches,
       count(*) FILTER (WHERE c IS DISTINCT FROM e) AS jdate_interval_mismatches
FROM q GROUP BY step ORDER BY step;
 months_step | series | elements | jtimestamp_mismatches | jdate_interval_mismatches 
-------------+--------+----------+-----------------------+---------------------------
         -12 |    366 |     1463 |                     0 |                         0
          -1 |    366 |     7159 |                     0 |                         0
           1 |    366 |     3648 |                     0 |                         0
          12 |    366 |     1097 |                     0 |                         0
(4 rows)

-- jtimestamp without a month against core's generate_series on the same numbers
SELECT count(*) AS series, sum(cardinality(b)) AS elements,
       count(*) FILTER (WHERE a IS DISTINCT FROM b) AS mismatches
FROM (SELECT ARRAY(SELECT g::timestamp FROM jgenerate_series(s.st::jtimestamp, timestamp '2024-12-31 23:00'::jtimestamp, v.step) g) AS a,
             ARRAY(SELECT g FROM generate_series(s.st, timestamp '2024-12-31 23:00', v.step) g) AS b
      FROM (SELECT timestamp '2024-01-01 00:00' + h * interval '1 hour' AS st FROM generate_series(0, 23) h) s,
           (VALUES (interval '1 day'), (interval '7 days'), (interval '1 hour'), (interval '36 hours'),
                   (interval '1 day 1 minute')) v(step)) q;
 series | elements | mismatches 
--------+----------+------------
    120 |   235229 |          0
(1 row)

-- jgenerate_series(jdate, jdate, int): the days, steps 1, 7, 31 and 45 forward and
-- backward, against Gregorian day arithmetic on the same dates
SELECT k AS step, count(*) AS series, sum(cardinality(b)) AS elements,
       count(*) FILTER (WHERE a IS DISTINCT FROM b) AS mismatches
FROM (SELECT k,
             ARRAY(SELECT g::date FROM jgenerate_series(s.d0::jdate, s.d1::jdate, k) g) AS a,
             ARRAY(SELECT s.d0 + i * k FROM generate_series(0, (s.d1 - s.d0) / abs(k)) i) AS b
      FROM (SELECT date '2024-01-01' + o AS d0, date '2024-12-31' AS d1 FROM generate_series(0, 20) o) s,
           (VALUES (1), (7), (31), (45)) st(k)
      UNION ALL
      SELECT -k, ARRAY(SELECT g::date FROM jgenerate_series(s.d1::jdate, s.d0::jdate, -k) g),
             ARRAY(SELECT s.d1 - i * k FROM generate_series(0, (s.d1 - s.d0) / k) i)
      FROM (SELECT date '2024-01-01' + o AS d0, date '2024-12-31' AS d1 FROM generate_series(0, 20) o) s,
           (VALUES (1), (7), (31), (45)) st(k)) q(k, a, b)
GROUP BY k ORDER BY k;
 step | series | elements | mismatches 
------+--------+----------+------------
  -45 |     21 |      174 |          0
  -31 |     21 |      252 |          0
   -7 |     21 |     1077 |          0
   -1 |     21 |     7476 |          0
    1 |     21 |     7476 |          0
    7 |     21 |     1077 |          0
   31 |     21 |      252 |          0
   45 |     21 |      174 |          0
(8 rows)

-- ---------------------------------------------------------------------
-- 5. jdate_bin over the same hours. The bins are fixed lengths of elapsed time
--    from the origin, so a jtimestamptz bin is not a local day. Each source of 2024
--    (every hour) and of 2020, against core's date_bin on the same instants, and
--    against a formula on whole seconds: origin + floor((source - origin) /
--    stride) * stride. Origins: UTC midnight, the local midnight of Tehran,
--    Paris and Kathmandu, and one after the sources (so the bin start is below
--    the source and below the origin).
-- ---------------------------------------------------------------------
CREATE TEMP TABLE sw_origins (name text, o timestamptz);
INSERT INTO sw_origins VALUES
  ('UTC midnight', timestamptz '2024-01-01 00:00+00'),
  ('Tehran midnight', timestamptz '2020-03-20 00:00 Asia/Tehran'),
  ('Paris midnight', timestamptz '2024-01-01 00:00 Europe/Paris'),
  ('Kathmandu midnight', timestamptz '2024-01-01 00:00 Asia/Kathmandu'),
  ('after the sources', timestamptz '2030-01-01 00:00+00');
CREATE TEMP TABLE sw_strides (stride interval, secs bigint);
INSERT INTO sw_strides SELECT s, extract(epoch FROM s)::bigint
FROM (VALUES (interval '15 minutes'), (interval '45 minutes'), (interval '1 hour'), (interval '1 day'),
             (interval '36 hours'), (interval '7 days')) v(s);
CREATE FUNCTION pg_temp.sweep_bin(grid regclass, shift bigint DEFAULT 0)
RETURNS TABLE (origin text, cases bigint, vs_core bigint, vs_formula bigint, vs_core_jtimestamp bigint)
LANGUAGE plpgsql AS $f$
BEGIN
    RETURN QUERY EXECUTE format($q$
    SELECT o.name, count(*),
           count(*) FILTER (WHERE jdate_bin(s.stride, g.t::jtimestamptz, o.o::jtimestamptz)::timestamptz
                                  IS DISTINCT FROM date_bin(s.stride, g.t, o.o)),
           count(*) FILTER (WHERE jdate_bin(s.stride, g.t::jtimestamptz, o.o::jtimestamptz)::timestamptz
                                  IS DISTINCT FROM to_timestamp(extract(epoch FROM o.o)::bigint + %2$s
                                      + floor((extract(epoch FROM g.t)::bigint - extract(epoch FROM o.o)::bigint - %2$s)::numeric
                                              / s.secs) * s.secs)),
           count(*) FILTER (WHERE jdate_bin(s.stride, (g.t AT TIME ZONE 'UTC')::jtimestamp,
                                            (o.o AT TIME ZONE 'UTC')::jtimestamp)::timestamp
                                  IS DISTINCT FROM date_bin(s.stride, g.t AT TIME ZONE 'UTC', o.o AT TIME ZONE 'UTC'))
    FROM %1$s g, sw_origins o, sw_strides s
    GROUP BY o.name ORDER BY o.name COLLATE "C"
    $q$, grid, shift);
END
$f$;
SELECT '2024' AS grid, * FROM pg_temp.sweep_bin('sw_h2024');
