-- Stage J3 sweeps: the interval arithmetic, series and binning of jtimestamp,
-- jtimestamptz and jdate checked against an independent oracle, over every
-- hour of 2024 and of 2020, every month end of the leap years 1399 to 1412 and
-- the common years between, and both range edges in five time zones. The
-- hand-computed tables of jt_arith, jt_dst, jt_series and jt_bin say what the
-- right answers are in chosen cases; this file says there is no case, in these
-- grids, where the C code and the oracle part.
--
-- The oracle uses no code under test. Its Jalali side is the real jdate type:
-- jdate_part for the year, month and day, the text parser for the date of a month
-- (the month length is 31, 30, or 29 and 30 when 12-30 parses, which is the
-- leap rule of the jdate parser), the casts jdate <-> date for the Gregorian day.
-- Its Gregorian side is core's own arithmetic on timestamp and timestamptz:
-- AT TIME ZONE for the wall clock of a zone and its gap and overlap rule,
-- interval '1 day' on a wall clock, date_bin for the bins, generate_series for the
-- series without a month. A month step of the oracle is: the local date of the
-- instant in the zone, the same date n Jalali months later with the day clamped to
-- the month length, the same wall time, back to an instant by core. Nothing here
-- calls jdate_add_months, the local-time helper, or the + operators of the new
-- types except as the thing being tested.
--
-- Every sweep prints counts and booleans only, so the output is the same on every
-- server whatever its time zone data (the witnesses that a grid really contains a
-- gap or an overlap are booleans). Errors are shown as SQLSTATE only. The file
-- passes on correct code by design; the negative controls (section 6) show that
-- the sweeps can fail: each feeds a deliberately wrong oracle and must report
-- mismatches. The last section (7) is the volatility catalog of every function the
-- stage added.
SET DateStyle = 'ISO, YMD';
SET IntervalStyle = 'postgres';
SET timezone = 'UTC';
\set VERBOSITY sqlstate
-- ---------------------------------------------------------------------
-- The oracle
-- ---------------------------------------------------------------------
-- text of a Jalali date
CREATE FUNCTION pg_temp.ymd(y int, m int, d int) RETURNS text
LANGUAGE sql IMMUTABLE AS $$
    SELECT CASE WHEN y < 0 THEN '-' ELSE '' END || lpad(abs(y)::text, 4, '0')
           || '-' || lpad(m::text, 2, '0') || '-' || lpad(d::text, 2, '0')
$$;
-- month length: 31 for months 1 to 6, 30 for 7 to 11, and for Esfand 29, or 30 when
-- the jdate parser accepts the 30th (it is the leap test of the type)
CREATE FUNCTION pg_temp.mlen(y int, m int) RETURNS int
LANGUAGE sql IMMUTABLE AS $$
    SELECT CASE WHEN m <= 6 THEN 31 WHEN m <= 11 THEN 30
                ELSE 29 + pg_input_is_valid(pg_temp.ymd(y, 12, 30), 'jdate')::int END
$$;
-- months counted from year 0 month 1, and back (floor division, so negative
-- counts work); n months after d is the month t of this count
CREATE FUNCTION pg_temp.tmonths(d jdate, n int) RETURNS int
LANGUAGE sql IMMUTABLE AS $$
    SELECT jdate_part('year', d)::int * 12 + jdate_part('month', d)::int - 1 + n
$$;
CREATE FUNCTION pg_temp.ty(t int) RETURNS int
LANGUAGE sql IMMUTABLE AS $$ SELECT (t - ((t % 12) + 12) % 12) / 12 $$;
CREATE FUNCTION pg_temp.tm(t int) RETURNS int
LANGUAGE sql IMMUTABLE AS $$ SELECT ((t % 12) + 12) % 12 + 1 $$;
-- n Jalali months after d, the day clamped to the length of the target month;
-- NULL when the target year is outside -61 .. 3177
CREATE FUNCTION pg_temp.oadd(d jdate, n int) RETURNS jdate
LANGUAGE sql IMMUTABLE AS $$
    SELECT CASE WHEN pg_temp.ty(pg_temp.tmonths(d, n)) BETWEEN -61 AND 3177
                THEN pg_temp.ymd(pg_temp.ty(pg_temp.tmonths(d, n)), pg_temp.tm(pg_temp.tmonths(d, n)),
                                 least(jdate_part('day', d)::int,
                                       pg_temp.mlen(pg_temp.ty(pg_temp.tmonths(d, n)),
                                                    pg_temp.tm(pg_temp.tmonths(d, n)))))::jdate
           END
$$;
-- the oracle against the report's 15-row table (computed there by hand): 15 of 15
SELECT count(*) AS rows, count(*) FILTER (WHERE pg_temp.oadd(s::jdate, n)::text IS NOT DISTINCT FROM e) AS oracle_matches_report
FROM (VALUES ('1403-06-31', 1, '1403-07-30'), ('1403-06-31', 6, '1403-12-30'),
             ('1403-07-30', -1, '1403-06-30'), ('1403-12-30', 12, '1404-12-29'),
             ('1403-12-30', 60, '1408-12-30'), ('1403-12-30', -12, '1402-12-29'),
             ('1403-12-30', -60, '1398-12-29'), ('1403-11-30', 1, '1403-12-30'),
             ('1404-11-30', 1, '1404-12-29'), ('1403-01-31', 11, '1403-12-30'),
             ('1403-01-31', 12, '1404-01-31'), ('0000-01-31', -1, '-0001-12-29'),
             ('0001-01-30', -1, '0000-12-30'), ('3177-12-29', -1, '3177-11-29'),
             ('3177-12-29', 1, NULL)) v(s, n, e);
 rows | oracle_matches_report 
------+-----------------------
   15 |                    15
(1 row)

-- the leap years of the jdate parser in 1398 to 1413, and the month lengths: the
-- last day of a month is followed by the first day of the next one
SELECT string_agg(y::text, ' ' ORDER BY y) AS leap_years_1398_1413
FROM generate_series(1398, 1413) y WHERE pg_temp.mlen(y, 12) = 30;
 leap_years_1398_1413 
----------------------
 1399 1403 1408 1412
(1 row)

SELECT count(*) AS month_ends,
       count(*) FILTER (WHERE pg_temp.ymd(y, m, pg_temp.mlen(y, m))::jdate + 1
                              = pg_temp.ymd(y + m / 12, m % 12 + 1, 1)::jdate) AS followed_by_next_first
FROM generate_series(1380, 1430) y, generate_series(1, 12) m;
 month_ends | followed_by_next_first 
------------+------------------------
        612 |                    612
(1 row)

SELECT count(*) AS years, count(*) FILTER (WHERE pg_temp.ymd(y + 1, 1, 1)::jdate - pg_temp.ymd(y, 1, 1)::jdate
                                                 = 365 + (pg_temp.mlen(y, 12) - 29)) AS year_lengths_agree
FROM generate_series(1380, 1430) y;
 years | year_lengths_agree 
-------+--------------------
    51 |                 51
(1 row)

-- the oracle table of month steps for the local dates the grids reach: the
-- Gregorian date, the step in Jalali months (1, -1, 12, -12), and the Gregorian
-- date that many months later. It covers 2015-12 to 2027-12, so the hours of 2020
-- and 2024 and the series that start in them and run a year or two past them in
-- either direction.
CREATE TEMP TABLE sw_dmap AS
SELECT d::date AS d, n, pg_temp.oadd(d::date::jdate, n)::date AS nd
FROM generate_series(date '2015-12-01', date '2027-12-31', interval '1 day') days(d),
     (VALUES (1), (-1), (12), (-12)) v(n);
CREATE UNIQUE INDEX ON sw_dmap (d, n);
ANALYZE sw_dmap;
SELECT count(*) AS oracle_rows, count(*) FILTER (WHERE nd IS NULL) AS without_target FROM sw_dmap;
 oracle_rows | without_target 
-------------+----------------
       17656 |              0
(1 row)

-- "ERR <sqlstate>" or the text of the single value of a query
CREATE FUNCTION pg_temp.show(q text) RETURNS text
LANGUAGE plpgsql AS $f$
DECLARE
    r text;
BEGIN
    EXECUTE q INTO r;
    RETURN coalesce(r, 'NULL');
EXCEPTION WHEN OTHERS THEN
    RETURN 'ERR ' || SQLSTATE;
END
$f$;
-- the same under a time zone (set for the one statement, UTC afterwards)
CREATE FUNCTION pg_temp.show_in(zone text, q text) RETURNS text
LANGUAGE plpgsql AS $f$
DECLARE
    r text;
BEGIN
    PERFORM set_config('TimeZone', zone, false);
    r := pg_temp.show(q);
    PERFORM set_config('TimeZone', 'UTC', false);
    RETURN r;
END
$f$;
-- ---------------------------------------------------------------------
-- 1. Every hour of 2024 and of 2020: jtimestamptz + '1 day', - '1 day',
--    + '1 month' and - '1 month' in Asia/Tehran, Europe/Paris and Asia/Kathmandu,
--    each against the oracle in the same zone. The grids are the hourly UTC
--    instants (8784 each, both years are leap years). The oracle takes the wall
--    clock by core's AT TIME ZONE, adds one day by core's wall clock arithmetic
--    or one Jalali month by the oracle table, and goes back to an instant by core's
--    AT TIME ZONE (a wall time in a gap moves forward, an ambiguous one is the
--    second occurrence). The witnesses say the grid reaches a gap (a step lands on
--    a wall time that does not exist) and an overlap (it lands on one that occurs
--    twice), for the day step and for the month step: Paris in 2024 and 2020 and
--    Tehran in 2020 have both (Tehran gave up daylight saving time in 2022), Kathmandu
--    neither.
-- ---------------------------------------------------------------------
CREATE TEMP TABLE sw_h2024 AS
SELECT g.t FROM generate_series(timestamptz '2024-01-01 00:00+00', timestamptz '2024-12-31 23:00+00',
                                interval '1 hour') g(t);
CREATE TEMP TABLE sw_h2020 AS
SELECT g.t FROM generate_series(timestamptz '2020-01-01 00:00+00', timestamptz '2020-12-31 23:00+00',
                                interval '1 hour') g(t);
SELECT (SELECT count(*) FROM sw_h2024) AS hours_2024, (SELECT count(*) FROM sw_h2020) AS hours_2020;
 hours_2024 | hours_2020 
------------+------------
       8784 |       8784
(1 row)

-- skew shifts every oracle instant (zero in the sweeps, not zero in a control)
CREATE FUNCTION pg_temp.sweep_hours(z text, grid regclass, skew interval DEFAULT '0')
RETURNS TABLE (hours bigint, plus_day bigint, minus_day bigint, plus_month bigint,
               minus_month bigint, gap_day boolean, overlap_day boolean,
               gap_month boolean, overlap_month boolean)
LANGUAGE plpgsql AS $f$
BEGIN
    PERFORM set_config('TimeZone', z, false);
    RETURN QUERY EXECUTE format($q$
    WITH j AS (
        SELECT w.t, w.loc, w.t::jtimestamptz AS jt, w.loc::time AS tod, p.nd AS nplus, m.nd AS nminus
        FROM (SELECT g.t, g.t AT TIME ZONE %1$L AS loc FROM %2$s g) w
        JOIN sw_dmap p ON p.d = w.loc::date AND p.n = 1
        JOIN sw_dmap m ON m.d = w.loc::date AND m.n = -1
    )
    SELECT count(*),
           count(*) FILTER (WHERE (j.jt + interval '1 day')::timestamptz
                                  IS DISTINCT FROM ((j.loc + interval '1 day') AT TIME ZONE %1$L) + %3$L::interval),
           count(*) FILTER (WHERE (j.jt - interval '1 day')::timestamptz
                                  IS DISTINCT FROM ((j.loc - interval '1 day') AT TIME ZONE %1$L) + %3$L::interval),
           count(*) FILTER (WHERE (j.jt + interval '1 month')::timestamptz
                                  IS DISTINCT FROM ((j.nplus + j.tod) AT TIME ZONE %1$L) + %3$L::interval),
           count(*) FILTER (WHERE (j.jt - interval '1 month')::timestamptz
                                  IS DISTINCT FROM ((j.nminus + j.tod) AT TIME ZONE %1$L) + %3$L::interval),
           -- the day step landed on a wall time that does not exist
           count(*) FILTER (WHERE ((j.loc + interval '1 day') AT TIME ZONE %1$L) AT TIME ZONE %1$L
                                  <> j.loc + interval '1 day') > 0,
           -- ... or on one that occurs twice (the hour before has the same wall time)
           count(*) FILTER (WHERE (((j.loc + interval '1 day') AT TIME ZONE %1$L) - interval '1 hour')
                                    AT TIME ZONE %1$L = j.loc + interval '1 day') > 0,
           -- the same two for the wall time the month step lands on (+1 month)
           count(*) FILTER (WHERE ((j.nplus + j.tod) AT TIME ZONE %1$L) AT TIME ZONE %1$L
                                  <> j.nplus + j.tod) > 0,
           count(*) FILTER (WHERE (((j.nplus + j.tod) AT TIME ZONE %1$L) - interval '1 hour')
                                    AT TIME ZONE %1$L = j.nplus + j.tod) > 0
    FROM j
    $q$, z, grid, skew);
    PERFORM set_config('TimeZone', 'UTC', false);
END
$f$;
SELECT 'Asia/Tehran 2024' AS grid, * FROM pg_temp.sweep_hours('Asia/Tehran', 'sw_h2024');
       grid       | hours | plus_day | minus_day | plus_month | minus_month | gap_day | overlap_day | gap_month | overlap_month 
------------------+-------+----------+-----------+------------+-------------+---------+-------------+-----------+---------------
 Asia/Tehran 2024 |  8784 |        0 |         0 |          0 |           0 | f       | f           | f         | f
(1 row)

SELECT 'Europe/Paris 2024' AS grid, * FROM pg_temp.sweep_hours('Europe/Paris', 'sw_h2024');
       grid        | hours | plus_day | minus_day | plus_month | minus_month | gap_day | overlap_day | gap_month | overlap_month 
-------------------+-------+----------+-----------+------------+-------------+---------+-------------+-----------+---------------
 Europe/Paris 2024 |  8784 |        0 |         0 |          0 |           0 | t       | t           | t         | t
(1 row)

SELECT 'Asia/Kathmandu 2024' AS grid, * FROM pg_temp.sweep_hours('Asia/Kathmandu', 'sw_h2024');
        grid         | hours | plus_day | minus_day | plus_month | minus_month | gap_day | overlap_day | gap_month | overlap_month 
---------------------+-------+----------+-----------+------------+-------------+---------+-------------+-----------+---------------
 Asia/Kathmandu 2024 |  8784 |        0 |         0 |          0 |           0 | f       | f           | f         | f
(1 row)

