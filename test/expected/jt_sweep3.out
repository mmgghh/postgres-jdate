-- the edge values themselves, computed by hand: UTC, and +15:59 where the last
-- valid instant is 23:58:59.999999 local (08:00 UTC less a microsecond)
SELECT label, pg_temp.show_in(zone, stmt) AS result
FROM (VALUES
  (1, 'first valid', 'UTC', $$SELECT '-0061-01-01 16:00:00+00'::jtimestamptz$$),
  (2, 'first - 1 hour', 'UTC', $$SELECT '-0061-01-01 16:00:00+00'::jtimestamptz - interval '1 hour'$$),
  (3, 'first + 1 day', 'UTC', $$SELECT '-0061-01-01 16:00:00+00'::jtimestamptz + interval '1 day'$$),
  (4, 'first + 1 month', 'UTC', $$SELECT '-0061-01-01 16:00:00+00'::jtimestamptz + interval '1 month'$$),
  (5, 'first - 1 month', 'UTC', $$SELECT '-0061-01-01 16:00:00+00'::jtimestamptz - interval '1 month'$$),
  (6, 'last valid', 'UTC', $$SELECT '3177-12-29 07:59:59.999999+00'::jtimestamptz$$),
  (7, 'last + 1 microsecond', 'UTC', $$SELECT '3177-12-29 07:59:59.999999+00'::jtimestamptz + interval '1 microsecond'$$),
  (8, 'last - 1 day', 'UTC', $$SELECT '3177-12-29 07:59:59.999999+00'::jtimestamptz - interval '1 day'$$),
  (9, 'last - 1 month', 'UTC', $$SELECT '3177-12-29 07:59:59.999999+00'::jtimestamptz - interval '1 month'$$),
  (10, 'last + 1 month', 'UTC', $$SELECT '3177-12-29 07:59:59.999999+00'::jtimestamptz + interval '1 month'$$),
  (11, 'last valid at +15:59', '<+15:59>-15:59', $$SELECT '3177-12-29 23:58:59.999999+15:59'::jtimestamptz$$),
  (12, 'last + 1 microsecond at +15:59', '<+15:59>-15:59',
       $$SELECT '3177-12-29 23:58:59.999999+15:59'::jtimestamptz + interval '1 microsecond'$$),
  (13, 'last - 1 day at +15:59', '<+15:59>-15:59',
       $$SELECT '3177-12-29 23:58:59.999999+15:59'::jtimestamptz - interval '1 day'$$)
) v(ord, label, zone, stmt)
ORDER BY ord;
