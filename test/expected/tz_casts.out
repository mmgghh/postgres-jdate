SELECT d, timestamptz(d) AT TIME ZONE 'UTC' AS midnight_utc, jdate(timestamptz(d)) = d AS roundtrip_ok
FROM (VALUES (jdate '1403-01-19'), (jdate '1403-07-08')) v(d) ORDER BY d;
     d      |    midnight_utc     | roundtrip_ok 
