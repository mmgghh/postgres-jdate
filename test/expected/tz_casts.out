             (timestamptz '2024-04-07 11:59:59+00'),
             (timestamptz '2024-04-07 12:00:00+00')) v(ts)
ORDER BY ts;
      local_ts       |    day     
---------------------+------------
 2024-04-06 23:59:59 | 1403-01-18
 2024-04-07 00:00:00 | 1403-01-19
 2024-04-07 02:30:00 | 1403-01-19
 2024-04-07 02:30:00 | 1403-01-19
 2024-04-07 23:59:59 | 1403-01-19
 2024-04-08 00:00:00 | 1403-01-20
(6 rows)

SELECT jdate(ts) AS day, count(*) AS hours
