SELECT jdate_format(timestamptz '2020-07-14 19:45:00+00') AS fmt_summer,
       jdate_format(timestamptz '2020-01-14 20:45:00+00') AS fmt_winter;
     fmt_summer      |     fmt_winter      
---------------------+---------------------
 1399-04-25 00:15:00 | 1398-10-25 00:15:00
